+class RejectingMock(MockLM):
+    """Every speculative sub-call is refused by the 'server' after 0.3 s."""
+
+    def sub_call(self, prompt, _spec=None):
+        if _spec is not None:
+            time.sleep(0.3)
+            raise SpeculationRejected("sptc_bet_rejected")
+        return super().sub_call(prompt)
+
