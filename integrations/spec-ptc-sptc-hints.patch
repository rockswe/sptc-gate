+    repl = BunREPL(reg, store, launcher, bus)
+    try:
+        repl.shadow_feed("ns.b = String(llm_query('q')) + '!';")
+        m = repl.execute_code("print(llm_query('q'));")
+        assert not m["error"] and m["stdout"] == "ans(q)", m
+        assert any(e.kind == "claim_hit" for e in bus.history)
+    finally:
+        repl.close()
+        launcher.shutdown()
