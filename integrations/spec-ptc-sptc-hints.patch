+def test_harness_claims_inflight_speculation_then_falls_back():
+    """The shadow never forces the results, so the real run claims the speculations while
+    they are still in flight; the server then refuses them and each claim re-runs for real."""
+    code = "a = llm_query('first: ' + context[:20])\nb = llm_query_batched(['x1', 'x2'])"
+    _, bus, ns = run_turn(RejectingMock(FAST), "spec", code, with_locals=True)
+    _, _, base = run_turn(MockLM(FAST), "baseline", code, with_locals=True)
+    assert norm(str(ns["a"])) == norm(str(base["a"])) and "mock-answer" in str(ns["a"])
+    assert [norm(str(x)) for x in ns["b"]] == [norm(str(x)) for x in base["b"]]
+    kinds = [e.kind for e in bus.history]
+    assert kinds.count("spec_fallback") + kinds.count("claim_miss") == 3, kinds
+    assert kinds.count("spec_fallback") >= 1, kinds  # the claim-then-reject path ran
+    assert kinds.count("spec_rejected") == kinds.count("dispatch")
