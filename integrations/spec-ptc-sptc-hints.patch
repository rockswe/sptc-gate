+CODE = (
+    "a = llm_query('first: ' + context[:20])\n"
+    "b = llm_query_batched(['x1', 'x2'])\n"
+    "answer['content'] = str(a) + '|' + '|'.join(str(r) for r in b)\n"
+    "answer['ready'] = True"
+)
