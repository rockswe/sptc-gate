+def _emit_fallback(bus: EventBus, key, spec: Speculation, tool, e: SpeculationRejected) -> None:
+    bus.emit("spec_fallback", key=key, seq=spec.seq, tool=tool.name, reason=e.reason)
+
+
+def _fallback(single, prompt, rest: tuple, kwargs: dict, batched, spec, e, bus):
+    """Real run of one element of an async batched claim whose speculation was rejected (the
+    elements run concurrently under gather). Returns the value, or an awaitable for async
