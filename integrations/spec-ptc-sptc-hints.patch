+# ------------------------------------------------------------------- fake OpenAI client
+def chunk(text=None, finish=None, stop=None):
+    choice = SimpleNamespace(delta=SimpleNamespace(content=text), finish_reason=finish)
+    if stop is not None:
+        choice.stop_reason = stop
+    return SimpleNamespace(choices=[choice])
