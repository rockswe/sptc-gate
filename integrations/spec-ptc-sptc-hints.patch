+def test_claim_of_rejected_speculation_reruns_for_real():
+    tool, calls = _tool()
+    bus, store, spec = _store_with(tool, ("p",), error=SpeculationRejected("sptc_bet_dropped"))
+    assert _claim_or_run(tool, ("p",), {}, store, bus) == "real(p)"
+    assert calls == ["p"]
+    kinds = [e.kind for e in bus.history]
+    assert kinds == ["claim_hit", "spec_fallback"]
+    assert bus.history[-1].data["reason"] == "sptc_bet_dropped"
+    assert spec.state != "claimed"  # counted as waste, not as a hit that saved time
