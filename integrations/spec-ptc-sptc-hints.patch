diff --git a/src/contracts/hints.py b/src/contracts/hints.py
new file mode 100644
index 0000000..32f15ef
--- /dev/null
+++ b/src/contracts/hints.py
@@ -0,0 +1,79 @@
+"""Scheduler hints for speculative sub-calls (the sptc vLLM / SGLang scheduler plugins).
+
+Speculative dispatches (shadow hooks and loop peeks) are tagged "early" through an
+OpenAI-compatible body field: `vllm_xargs` (vLLM turns it into SamplingParams.extra_args;
+the default) or `custom_params` (SGLang's SamplingParams.custom_params). Choose with the
+environment variable SPTC_TAG_FIELD. Real calls stay untagged (normal work). Servers that
+don't know the field ignore it: vanilla vLLM keeps unknown extra_args, vanilla SGLang keeps
+unknown custom_params, Ollama ignores unknown body fields.
+
+A server running the sptc scheduler may refuse or drop a speculative call. It then finishes it
+with finish_reason "abort" (vLLM: stop_reason, SGLang: matched_stop "sptc_bet_rejected" /
+"sptc_bet_dropped"), or, on vLLM, for a stream that had produced no token yet, ends the
+stream without any finish_reason (vLLM drops empty final chunks). That is not a tool
+failure: a claim of the speculation re-runs the call for real.
+"""
+
+from __future__ import annotations
+
+import os
+from collections.abc import Iterable
+from typing import Any
+
+SPTC_CLASS_KEY = "sptc_class"
+TAG_FIELDS = ("vllm_xargs", "custom_params")  # vLLM, SGLang
+TAG_FIELD_ENV = "SPTC_TAG_FIELD"
+
+
+class SpeculationRejected(RuntimeError):
+    """The server refused or dropped a speculative sub-call. Claims fall back to a real run."""
+
+    def __init__(self, reason: str | None = None) -> None:
+        super().__init__(f"speculative sub-call rejected by server ({reason})")
+        self.reason = reason
+
+
+def sptc_xargs(spec: Any) -> dict[str, str] | None:
+    """vllm_xargs for one sub-call: speculative dispatches are 'early', real calls untagged."""
+    return None if spec is None else {SPTC_CLASS_KEY: "early"}
+
+
+def tag_field() -> str:
+    field = os.environ.get(TAG_FIELD_ENV) or TAG_FIELDS[0]
+    if field not in TAG_FIELDS:
+        raise ValueError(f"{TAG_FIELD_ENV} must be one of {TAG_FIELDS}, got {field!r}")
+    return field
+
+
+def extra_body(spec: Any, enabled: bool = True) -> dict[str, Any] | None:
+    xargs = sptc_xargs(spec) if enabled else None
+    return {tag_field(): xargs} if xargs else None
+
+
+def stop_reason(choice: Any) -> Any:
+    """The server's stop detail for a finished choice: vLLM's stop_reason, SGLang's
+    matched_stop (both are extra fields of the OpenAI choice)."""
+    reason = getattr(choice, "stop_reason", None)
+    return reason if reason is not None else getattr(choice, "matched_stop", None)
+
+
+def net_hits(events: Iterable[Any]) -> int:
+    """Claim hits that actually used the speculation. A claim of a speculation the server
+    then refused emits claim_hit (at claim time, before the wait) and later spec_fallback,
+    and re-runs the call: it saved nothing, so it is not counted."""
+    hits = fallbacks = 0
+    for e in events:
+        if e.kind == "claim_hit":
+            hits += 1
+        elif e.kind == "spec_fallback":
+            fallbacks += 1
+    return hits - fallbacks
+
+
+def raise_if_rejected(finish_reason: str | None, stop_reason: Any = None) -> None:
+    """For speculative calls only: the server aborted the call, or the stream ended without a
+    finish_reason (vLLM's zero-token streaming finish)."""
+    if finish_reason is None or finish_reason == "abort":
+        raise SpeculationRejected(
+            str(stop_reason) if stop_reason else (finish_reason or "no_finish_reason")
+        )
