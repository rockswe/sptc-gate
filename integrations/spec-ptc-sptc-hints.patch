+# ----------------------------------------------------------------- claim-time fallback
+def _store_with(tool, args, *, error=None, done=True, state="running"):
+    bus = EventBus()
+    store = SpecStore(bus)
+    spec = Speculation(
+        key=spec_key(tool, args, {}), seq=1, args=args, kwargs={}, source="shadow"
+    )
+    spec.state = state
+    spec.error = error
+    if done:
+        spec.done.set()
+    store.put(spec)
+    return bus, store, spec
+
+
+def _tool(fn=None):
+    calls = []
+
+    def real(prompt):
+        calls.append(prompt)
+        return f"real({prompt})"
+
+    return ToolSpec(name="llm_query", fn=fn or real, speculatable=True, pure=True), calls
+
