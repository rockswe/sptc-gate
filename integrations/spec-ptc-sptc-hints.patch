+def run_turn(eng, mode, code, with_locals=False):
+    bus = EventBus()
+    h = Harness(eng, mode, bus=bus, context="x" * 300)
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{code}\n```\ndone"))
+    h.launcher.shutdown()
+    return (out, bus, h.repl.locals) if with_locals else (out, bus)
+
