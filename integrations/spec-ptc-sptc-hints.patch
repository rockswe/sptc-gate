+        spec.error = SpeculationRejected("sptc_bet_rejected")
+        spec.state = "failed"
+        spec.done.set()
+
+    threading.Thread(target=reject_later).start()
+    assert _claim_or_run(tool, ("p",), {}, store, bus) == "real(p)"
+    assert calls == ["p"] and any(e.kind == "spec_fallback" for e in bus.history)
