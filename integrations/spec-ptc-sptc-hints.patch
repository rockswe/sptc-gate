+        time.sleep(0.1)  # dispatched, still in flight: the claim waits, then it is rejected
+        assert c.resolve("llm_query", ["x: aa"]) is None  # miss: the host runs the tool
+        assert c.resolve("llm_query", ["never"]) is None  # connection still alive
+        c.turn_end()
