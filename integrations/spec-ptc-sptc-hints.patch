+def test_harness_answer_matches_baseline_when_server_rejects_speculation():
+    out, bus = run_turn(RejectingMock(FAST), "spec", CODE)
+    base, _ = run_turn(MockLM(FAST), "baseline", CODE)
+    assert out.final_answer and norm(out.final_answer) == norm(base.final_answer)
+    assert out.metrics.hits == 0  # fallbacks saved nothing: not reported as hits
+    assert out.metrics.fallbacks == sum(e.kind == "spec_fallback" for e in bus.history)
+    kinds = [e.kind for e in bus.history]
+    assert kinds.count("dispatch") >= 1
+    # every speculative dispatch was refused; each real call either claimed it and fell
+    # back, or missed it outright
+    assert kinds.count("spec_fallback") + kinds.count("claim_miss") == 3, kinds
+    assert kinds.count("claim_done") == 0
+
