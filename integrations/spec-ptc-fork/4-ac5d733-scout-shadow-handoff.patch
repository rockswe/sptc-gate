+
+# --------------------------------------------------------- a launch that takes long
+MANY_AT_ONCE = (
+    "questions = [f'Q{i}: item {i} ?' for i in range(60)]\n"
+    "labels = llm_query_batched(['Classify: ' + q for q in questions])\n"
+    "answer['content'] = str(len(labels))\n"
+    "answer['ready'] = True"
+)
+
+
+def _slow_launch_turn(monkeypatch, **harness_kw):
+    """A turn in a busy process: every launch takes 30 ms on the launching thread (here a
+    slow subscriber on the bus; on the H100 it was the other sessions holding the GIL).
+    The statement budget is cut to 0.2 s so that 60 launches are far beyond it."""
+    import time as _time
+
+    import spec_ptc.engine.shadow as shadow_mod
+
+    monkeypatch.setattr(shadow_mod, "STMT_WALL_BUDGET_S", 0.2)
+    eng = MockLM(TIMING)
+    bus = EventBus()
+
+    def busy(ev):
+        if ev.kind == "dispatch":
+            _time.sleep(0.03)
+
+    bus.subscribe(busy)
+    h = Harness(eng, "spec", bus=bus, context=CONTEXT, scout=True, max_inflight=64, **harness_kw)
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{MANY_AT_ONCE}\n```\ndone"))
+    h.launcher.shutdown()
+    return out, bus.history
+
+
+@pytest.mark.parametrize("batch_launch", [False, True])
+def test_a_launch_longer_than_the_shadows_patience_is_not_made_twice(monkeypatch, batch_launch):
+    """Recorded on an H100 (replay, 2026-11-10): in a process busy with 128 calls in
+    flight the scout needed 6.6 s to launch 3,182 prompts. The shadow waited 3 s for it,
+    then launched the rest itself, and the scout launched them too: 1,042 calls ran
+    twice, and the turn's dispatch cap ran out."""
+    out, hist = _slow_launch_turn(monkeypatch, batch_launch=batch_launch)
+    k = kinds(hist)
+    assert out.final_answer == "60"
+    assert k.count("dispatch") == 60  # each prompt launched once
+    assert k.count("evict") == 0 and k.count("claim_hit") == 60 and k.count("claim_miss") == 0
+    assert {e.data["source"] for e in hist if e.kind == "dispatch"} == {"peek"}
+    # launching is not the statement's own computing: the watchdog leaves it alone
+    assert "ShadowAborted" not in [e.data.get("reason") for e in hist if e.kind == "scout_skip"]
+
+
+def test_a_batch_launch_that_is_interrupted_still_runs_what_it_announced():
+    """Whatever stops a launch half-way, a speculation that is in the store must run:
+    the shadow adopts it and the real run would wait for it."""
+    from spec_ptc.contracts.tools import ToolRegistry
+    from spec_ptc.engine.speculation import Launcher, SpecStore
+
+    class Cut(BaseException):
+        pass
+
+    reg = ToolRegistry()
+    single = reg.register("llm_query", lambda p: f"one({p})", speculatable=True, pure=True)
+    batched = reg.register("llm_query_batched", lambda ps: [f"many({p})" for p in ps],
+                           speculatable=True, pure=True, batched=True)
+    store = SpecStore()
+    launcher = Launcher(store, batch_launch=True)
+    real_create = launcher._create
+    n = {"made": 0}
+
+    def create(*a, **kw):
+        if n["made"] == 2:
+            raise Cut()  # as an asynchronous exception would land, in the middle
+        n["made"] += 1
+        return real_create(*a, **kw)
+
+    launcher._create = create
+    with pytest.raises(Cut):
+        launcher.dispatch_batch(batched, single, ["a", "b", "c", "d"], (), {}, "peek")
+    assert len(store.all) == 2
+    assert all(s.done.wait(2) for s in store.all)
+    assert [s.result for s in store.all] == ["many(a)", "many(b)"]
+    launcher.shutdown()
+
+
+def test_the_shadows_own_launches_are_not_its_computing_either(monkeypatch):
+    """Recorded on an H100 (replay, 2026-11-10), spec-ptc as shipped: a statement that
+    launched 3,182 calls was cut by the runaway guard after 2,760, in one of two units.
+    The guard budgets a statement's own computing, and it counted the launching."""
+    import time as _time
+
+    import spec_ptc.engine.shadow as shadow_mod
+
+    monkeypatch.setattr(shadow_mod, "STMT_WALL_BUDGET_S", 0.2)
+    eng = MockLM(TIMING)
+    bus = EventBus()
+    bus.subscribe(lambda ev: _time.sleep(0.03) if ev.kind == "dispatch" else None)
+    h = Harness(eng, "spec", bus=bus, context=CONTEXT, scout=False, max_inflight=64)
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{MANY_AT_ONCE}\n```\ndone"))
+    h.launcher.shutdown()
+    k = kinds(bus.history)
+    assert out.final_answer == "60"
+    assert "shadow_stop" not in k
+    assert k.count("dispatch") == 60 and k.count("claim_hit") == 60 and k.count("claim_miss") == 0
