+def test_a_batch_refused_after_it_was_claimed_is_re_run_as_one_batch():
+    calls = []
+    refuse = threading.Event()
+
+    def batched(prompts, _spec=None):
+        calls.append((list(prompts), _spec is not None))
+        if _spec is not None:
+            refuse.wait(5)
+            raise SpeculationRejected("sptc_bet_dropped")
+        return [f"real({p})" for p in prompts]
+
+    batched.wants_spec = True
+    reg, bus, store, launcher = launcher_with(batched)
+    shadow = make_shadow_hooks(reg, launcher)
+    real = make_real_hooks(reg, store, launcher, bus)
+    shadow["llm_query_batched"](["a", "b", "c"])
+    threading.Timer(0.1, refuse.set).start()  # the real run is already waiting by then
+    assert real["llm_query_batched"](["a", "b", "c"]) == ["real(a)", "real(b)", "real(c)"]
+    assert calls == [(["a", "b", "c"], True), (["a", "b", "c"], False)]
+    assert kinds(bus.history).count("claim_hit") == 3
+    assert kinds(bus.history).count("spec_fallback") == 3
+    launcher.shutdown()
