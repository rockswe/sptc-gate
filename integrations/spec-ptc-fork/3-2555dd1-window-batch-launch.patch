+# ------------------------------------------------------------------ the launcher alone
+def launcher_with(batched_fn, single_fn=None, max_inflight=16, batch_width=None, **kw):
+    reg = ToolRegistry()
+    reg.register("llm_query", single_fn or (lambda p: f"one({p})"), speculatable=True, pure=True)
+    reg.register("llm_query_batched", batched_fn, speculatable=True, pure=True, batched=True,
+                 batch_width=batch_width)
+    bus = EventBus()
+    store = SpecStore(bus)
+    launcher = Launcher(store, bus, Budget(max_inflight=max_inflight, **kw), batch_launch=True)
+    return reg, bus, store, launcher
+
+
+def test_an_element_the_scout_launched_is_adopted_and_the_rest_go_out_as_one_batch():
+    seen = []
+
+    def batched(prompts):
+        seen.append(list(prompts))
+        return [f"many({p})" for p in prompts]
+
+    reg, bus, store, launcher = launcher_with(batched)
+    scout = make_scout_hooks(reg, launcher)
+    shadow = make_shadow_hooks(reg, launcher)
+    real = make_real_hooks(reg, store, launcher, bus)
+    scout["llm_query_batched"](["a", "b"])  # the scout saw only the first two
+    vals = shadow["llm_query_batched"](["a", "b", "c", "d"])
+    assert [str(v) for v in vals] == ["many(a)", "many(b)", "many(c)", "many(d)"]
+    assert seen == [["a", "b"], ["c", "d"]]  # two calls of the tool, no prompt twice
+    assert real["llm_query_batched"](["a", "b", "c", "d"]) == [
+        "many(a)", "many(b)", "many(c)", "many(d)"]
+    k = kinds(bus.history)
+    assert k.count("dispatch") == 4 and k.count("adopt") == 2 and k.count("claim_hit") == 4
+    launcher.shutdown()
+
