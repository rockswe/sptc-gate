+def test_launches_keep_their_order_at_the_window():
+    """A batch that needs the whole window is not overtaken by the single calls behind it."""
+    order = []
+    lock = threading.Lock()
+
+    def single(p):
+        with lock:
+            order.append(p)
+        time.sleep(0.05)
+        return p
+
+    def batched(prompts):
+        with lock:
+            order.append("batch")
+        time.sleep(0.05)
+        return list(prompts)
+
+    reg, bus, store, launcher = launcher_with(batched, single_fn=single, max_inflight=4)
+    scout = make_scout_hooks(reg, launcher)
+    for i in range(4):
+        scout["llm_query"](f"before {i}")
+    scout["llm_query_batched"]([f"b{i}" for i in range(8)])  # needs all four places
+    for i in range(8):
+        scout["llm_query"](f"after {i}")
+    deadline = time.time() + 5
+    while time.time() < deadline and not all(s.done.is_set() for s in store.all):
+        time.sleep(0.02)
+    at = order.index("batch")
+    assert sorted(order[:at]) == [f"before {i}" for i in range(4)]
+    launcher.shutdown()
+
