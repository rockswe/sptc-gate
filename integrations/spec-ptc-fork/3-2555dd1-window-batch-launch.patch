index 0000000..420d9fc
--- /dev/null
+++ b/tests/test_window.py
@@ -0,0 +1,432 @@
+"""How wide speculation goes, and how a model-written batch is launched.
+
+The window (`max_inflight`) is the number of speculative calls in flight at once. As
+shipped it is 16, and a batch is launched as one thread per prompt. Two options, both off
+unless asked for:
+
+- a wider window: `max_inflight` is what the engine takes, not a constant;
+- a batch launched as a batch (`batch_launch=True`): one call of the batched tool for the
+  prompts nobody has launched yet. Each prompt keeps its own speculation, so the real run
+  claims them one by one as before. The batch counts against the window with the number
+  of calls the tool keeps in flight (`batch_width`), not as one.
+
+All mock: no network, no model."""
+
+import threading
+import time
+
+import pytest
+
+from spec_ptc.contracts.events import EventBus
+from spec_ptc.contracts.hints import SpeculationRejected
+from spec_ptc.contracts.tools import ToolRegistry
+from spec_ptc.engine.speculation import (
+    Budget,
+    Launcher,
+    SpecStore,
+    make_real_hooks,
+    make_scout_hooks,
+    make_shadow_hooks,
+)
+from spec_ptc.runtime.engines import MockLM, MockTiming
+from spec_ptc.runtime.harness import Harness
+
+TIMING = MockTiming(main_tok_per_s=2000, sub_base_s=0.2, sub_jitter_s=0.0, sub_tokens=2)
+CONTEXT = "\n".join(f"Q{i}: what is item number {i} ?" for i in range(48))
+
+
+class Counting(MockLM):
+    """Counts the calls in flight, and records how the batched tool was called."""
+
+    def __init__(self, timing=TIMING):
+        super().__init__(timing)
+        self.inflight = self.peak = 0
+        self.calls: list[tuple[str, bool]] = []  # (prompt, speculative)
+        self.batches: list[list[str]] = []  # one entry per call of the batched tool
+        self._rec = threading.Lock()
+
+    def sub_call(self, prompt, _spec=None):
+        with self._rec:
+            self.inflight += 1
+            self.peak = max(self.peak, self.inflight)
+            self.calls.append((prompt, _spec is not None))
+        try:
+            return super().sub_call(prompt, _spec=_spec)
+        finally:
+            with self._rec:
+                self.inflight -= 1
+
+    def make_tools(self, reg, bus):
+        super().make_tools(reg, bus)
+        tool = reg.get("llm_query_batched")
+        inner = tool.fn
+
+        def batched(prompts, **kw):
+            with self._rec:
+                self.batches.append(list(prompts))
+            return inner(prompts, **kw)
+
+        batched.wants_spec = getattr(inner, "wants_spec", False)
+        tool.fn = batched
+
+
+def run_turn(code, eng=None, mode="spec", **kw):
+    eng = eng or Counting()
+    bus = EventBus()
+    h = Harness(eng, mode, bus=bus, context=CONTEXT, **kw)
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{code}\n```\ndone"))
+    h.launcher.shutdown()
+    return out, bus.history, eng
+
+
+def kinds(history):
+    return [e.kind for e in history]
+
+
+# ------------------------------------------------------------------ the window
+LOOP_48 = (
+    "questions = context.split('\\n')\n"
+    "labels = []\n"
+    "for q in questions:\n"
+    "    labels.append(llm_query('Classify: ' + q).strip())\n"  # each result is used
+    "answer['content'] = str(len(labels))\n"
+    "answer['ready'] = True"
+)
+
+
+@pytest.mark.parametrize("window", [4, 16, 48])
+def test_the_window_is_the_number_of_calls_in_flight(window):
+    """48 independent calls of 0.2 s, launched by the scout: `window` of them run at once,
+    and the turn takes about 48 / window rounds."""
+    out, hist, eng = run_turn(LOOP_48, scout=True, max_inflight=window)
+    assert out.final_answer == "48"
+    assert kinds(hist).count("claim_hit") == 48 and kinds(hist).count("claim_miss") == 0
+    assert eng.peak == window
+    rounds = 48 / window
+    assert 0.2 * rounds * 0.9 < out.metrics.t_turn < 0.2 * rounds * 1.5 + 0.6
