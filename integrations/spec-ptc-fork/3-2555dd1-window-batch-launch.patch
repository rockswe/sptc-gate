+def test_a_batch_is_launched_as_one_call_of_the_batched_tool():
+    base, _, _ = run_turn(ONE_BATCH, mode="baseline")
+    out, hist, eng = run_turn(ONE_BATCH, batch_launch=True)
+    assert norm(out.final_answer) == norm(base.final_answer)  # same answers, same order
+    assert len(eng.batches) == 1 and len(eng.batches[0]) == 24
+    assert all(spec for _, spec in eng.calls)  # every element ran as a speculative call
+    # each prompt is still its own speculation, claimed by the real run one by one
+    k = kinds(hist)
+    assert k.count("dispatch") == 24 and k.count("claim_hit") == 24
+    assert k.count("claim_miss") == 0 and k.count("evict") == 0
+    assert {e.data.get("batch") for e in hist if e.kind == "dispatch"} == {24}
