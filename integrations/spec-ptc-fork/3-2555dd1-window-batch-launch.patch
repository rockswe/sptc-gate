+# ------------------------------------------------------------------ a batch as a batch
+ONE_BATCH = (
+    "questions = context.split('\\n')[:24]\n"
+    "prompts = ['Classify: ' + q for q in questions]\n"
+    "labels = llm_query_batched(prompts)\n"
+    "answer['content'] = '|'.join(labels)\n"
+    "answer['ready'] = True"
+)
+
