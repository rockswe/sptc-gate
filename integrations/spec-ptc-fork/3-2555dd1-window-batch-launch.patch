 from spec_ptc.contracts.hints import extra_body, raise_if_rejected, stop_reason
 from spec_ptc.contracts.tools import ToolRegistry
 
+BATCH_WIDTH = 8  # calls of one batch these engines' batched tool keeps in flight
+
+
+def _batched_tool(sub_call):
+    """llm_query_batched over `sub_call`, BATCH_WIDTH prompts at a time.
+
+    Called by the program it gets no `_spec` and behaves as before. Launched as a batch
+    (Launcher.dispatch_batch) it gets one speculation per prompt: each call is then made
+    as that speculation's (tagged for the scheduler, cut if evicted), and a call that
+    fails hands back its exception in its own slot, so one refused or evicted element
+    does not fail the others."""
+
+    def one(prompt, spec):
+        if spec is None:
+            return sub_call(prompt)
+        try:
+            return sub_call(prompt, _spec=spec)
+        except Exception as e:  # noqa: BLE001 - this element's failure only
+            return e
+
+    def batched(prompts, _spec=None, **kw):
+        specs = _spec if _spec is not None else [None] * len(prompts)
+        with ThreadPoolExecutor(max_workers=BATCH_WIDTH) as pool:
+            return list(pool.map(one, prompts, specs))
+
+    batched.wants_spec = True  # type: ignore[attr-defined]
+    return batched
+
 
