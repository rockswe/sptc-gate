+BATCHES_IN_A_LOOP = (
+    "from collections import Counter\n"
+    "questions = context.split('\\n')\n"
+    "label_counts = Counter()\n"
+    "for i in range(0, len(questions), 8):\n"
+    "    prompts = [f'Classify. Question: {q}' for q in questions[i:i+8]]\n"
+    "    results = llm_query_batched(prompts)\n"
+    "    for r in results:\n"
+    "        label_counts[r] += 1\n"  # hashing r needs its value: the shadow waits here
+    "answer['content'] = str(sum(label_counts.values()))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_with_the_scout_every_batch_of_a_loop_goes_out_as_a_batch_at_once():
+    out, hist, eng = run_turn(BATCHES_IN_A_LOOP, scout=True, batch_launch=True, max_inflight=48)
+    assert out.final_answer == "48"
+    assert [len(b) for b in eng.batches] == [8] * 6  # six calls of the batched tool
+    k = kinds(hist)
+    assert k.count("dispatch") == 48 and k.count("claim_hit") == 48
+    assert k.count("claim_miss") == 0 and k.count("evict") == 0
+    assert k.count("adopt") == 48  # the shadow took over what the scout had launched
+    first_ready = k.index("ready")
+    assert k[:first_ready].count("dispatch") == 48  # all out before the first answer
+    assert eng.peak == 48
