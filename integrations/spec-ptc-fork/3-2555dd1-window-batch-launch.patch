+    def follow_window(self, lm_handler: Any) -> None:
+        """Fit rlms' LM handler to this REPL's window. The REPL only holds the handler's
+        address; a client that holds the handler itself (a streaming RLM's turn) calls
+        this once per turn. Two of the handler's limits are sized for 16 calls:
+
+        - Its socket listens with a backlog of 5 (Python's default). Every single call is
+          its own connection, so a window of 128 opens 128 at once: the surplus is
+          dropped by the kernel, and rlms returns 'Error: Request failed: ...' as the
+          call's answer. The backlog is raised to twice the window.
+        - It keeps 16 prompts of a batch in flight (batch_max_concurrent), whatever the
+          engine could take. With spec_batch_launch on, it is raised to the window, for
+          the batches this REPL launches and for the ones the program sends itself, and
+          a batch launched as a batch then holds that many places."""
+        window = self.session.launcher.budget.max_inflight
+        sock = getattr(getattr(lm_handler, "_server", None), "socket", None)
+        if sock is not None and window > 5 and getattr(self, "_backlog_for", None) is not sock:
+            try:
+                sock.listen(max(128, 2 * window))  # listen() again resizes the queue
+                self._backlog_for = sock
+            except OSError:
+                pass
+        if not (self._batch_launch and self._rlms_batches):
+            return
+        current = getattr(lm_handler, "batch_max_concurrent", None)
+        if not isinstance(current, int):
+            return
+        if current < window:
+            lm_handler.batch_max_concurrent = current = window
+        for name in ("llm_query_batched", "rlm_query_batched"):
+            tool = self.reg.get(name)
+            if tool is not None and tool.batched:
