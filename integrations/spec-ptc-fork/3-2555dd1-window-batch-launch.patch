+def test_as_shipped_a_batch_is_one_single_call_per_prompt():
+    base, _, _ = run_turn(ONE_BATCH, mode="baseline")
+    out, hist, eng = run_turn(ONE_BATCH)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    assert eng.batches == []  # the batched tool itself was never called
+    assert kinds(hist).count("dispatch") == 24 and kinds(hist).count("claim_hit") == 24
