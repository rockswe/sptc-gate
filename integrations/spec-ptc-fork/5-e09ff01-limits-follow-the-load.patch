+def test_the_launcher_runs_long_calls_together_when_the_engine_has_room():
+    """Four calls of 100,000 characters. As shipped one runs at a time (120,000
+    characters in flight). With the pool they run together on an engine that has room,
+    and two at a time on one that has room for two."""
+
+    def peak_for(kv: float | None) -> int:
+        lock = threading.Lock()
+        state = {"now": 0, "peak": 0}
+
+        def slow(prompt):
+            with lock:
+                state["now"] += 1
+                state["peak"] = max(state["peak"], state["now"])
+            time.sleep(0.15)
+            with lock:
+                state["now"] -= 1
+            return "ok"
+
+        reg = ToolRegistry()
+        reg.register("llm_query", slow, speculatable=True, pure=True)
+        pool = None
+        if kv is not None:
+            _, pool = pool_with(kv=kv)
+        launcher = Launcher(SpecStore(), budget=Budget(kv_pool=pool))
+        scout = make_scout_hooks(reg, launcher)
+        for i in range(4):
+            scout["llm_query"](f"{i}" + "x" * 100_000)
+        deadline = time.time() + 5
+        while time.time() < deadline and not all(s.done.is_set() for s in launcher.store.all):
+            time.sleep(0.02)
+        launcher.shutdown()
+        return state["peak"]
+
+    assert peak_for(None) == 1  # as shipped
+    assert peak_for(0.0) == 4  # 4 x 33,334 tokens fit into 136,238
+    assert peak_for(0.44) == 2  # 68,119 tokens free: two fit, three do not
+
