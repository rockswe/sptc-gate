+# --------------------------------------------------------------------------- chunks
+def launcher_with(batched_fn, max_inflight=16, chunk=0, batch_width=None):
+    reg = ToolRegistry()
+    reg.register("llm_query", lambda p: f"one({p})", speculatable=True, pure=True)
+    reg.register("llm_query_batched", batched_fn, speculatable=True, pure=True, batched=True,
+                 batch_width=batch_width)
+    bus = EventBus()
+    store = SpecStore(bus)
+    launcher = Launcher(store, bus,
+                        Budget(max_inflight=max_inflight, max_dispatches_per_turn=4096),
+                        batch_launch=True, batch_chunk=chunk)
+    return reg, bus, store, launcher
+
+
+def wait_all(store, seconds=5.0):
+    deadline = time.time() + seconds
+    while time.time() < deadline and not all(s.done.is_set() for s in store.all):
+        time.sleep(0.01)
+
+
+def test_a_large_batch_goes_out_in_chunks_that_the_window_bounds():
+    lock = threading.Lock()
+    state = {"now": 0, "peak": 0}
+    seen: list[int] = []
+
+    def batched(prompts):
+        with lock:
+            seen.append(len(prompts))
+            state["now"] += len(prompts)
+            state["peak"] = max(state["peak"], state["now"])
+        time.sleep(0.05)
+        with lock:
+            state["now"] -= len(prompts)
+        return [f"many({p})" for p in prompts]
+
+    reg, bus, store, launcher = launcher_with(batched, max_inflight=16, chunk=8)
+    scout = make_scout_hooks(reg, launcher)
+    scout["llm_query_batched"]([f"p{i}" for i in range(100)])
+    wait_all(store)
+    assert sorted(seen, reverse=True) == [8] * 12 + [4]  # 13 calls of the tool
+    assert state["peak"] == 16  # two chunks at a time: what the window allows
+    assert [s.result for s in store.all] == [f"many(p{i})" for i in range(100)]
+    launcher.shutdown()
+
+
+def test_a_chunk_is_never_larger_than_the_window():
+    seen: list[int] = []
+
+    def batched(prompts):
+        seen.append(len(prompts))
+        return list(prompts)
+
+    reg, bus, store, launcher = launcher_with(batched, max_inflight=3, chunk=32)
+    make_scout_hooks(reg, launcher)["llm_query_batched"]([f"p{i}" for i in range(10)])
+    wait_all(store)
+    assert sorted(seen, reverse=True) == [3, 3, 3, 1]
+    launcher.shutdown()
+
