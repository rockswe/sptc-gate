+# --------------------------------------------------------------------------- past a test
+_PAST_STOP, _PAST_UNKNOWN = "__scout_stop__", "__scout_unknown__"
+_LEAVES = (ast.Return, ast.Raise, ast.Break, ast.Continue, ast.Assert)
+_OWN_SCOPE = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda, ast.ClassDef)
+
+
+def _can_leave(stmts: list[ast.stmt]) -> bool:
+    """Could running these statements leave the block they are in by a statement made
+    for it: return, raise, break, continue, assert? (Any statement can raise by
+    accident; the scout takes that risk everywhere.) Bodies of functions and classes
+    defined here are not run here and do not count."""
+    todo: list[ast.AST] = list(stmts)
+    while todo:
+        n = todo.pop()
+        if isinstance(n, _LEAVES):
+            return True
+        if not isinstance(n, _OWN_SCOPE):
+            todo.extend(ast.iter_child_nodes(n))
+    return False
+
+
+class _PastTests(ast.NodeTransformer):
+    def __init__(self) -> None:
+        self.n = 0
+
+    def _own_scope(self, node):
+        return node  # a name set in there is a local: leave its tests as they are
+
+    visit_FunctionDef = visit_AsyncFunctionDef = visit_Lambda = visit_ClassDef = _own_scope
+
+    def visit_If(self, node: ast.If):
+        self.generic_visit(node)  # the tests inside the arms first (elif is one of them)
+        arms = node.body + node.orelse
+        if _can_leave(arms):
+            return node
+        names: set[str] = set()
+        for stmt in arms:
+            names |= _assigned_names(stmt) | _bound_names(stmt)
+        self.n += 1
+        cond = f"__scout_test_{self.n}__"
+        names = {n for n in names if not n.startswith("__scout_")}
+        load = lambda name: ast.Name(id=name, ctx=ast.Load())  # noqa: E731
+        store = lambda name: ast.Name(id=name, ctx=ast.Store())  # noqa: E731
+        unknown = ast.Call(func=load(_PAST_UNKNOWN), args=[], keywords=[])
+        # the names an arm would have set are not known after it; the call counts the test
+        skipped = ast.Assign(targets=[store(n) for n in sorted(names)] or [store(cond)],
+                             value=unknown)
+        new = ast.Try(
+            body=[ast.Assign(targets=[store(cond)],
+                             value=ast.Call(func=load("bool"), args=[node.test], keywords=[]))],
+            handlers=[ast.ExceptHandler(type=load(_PAST_STOP), name=None, body=[skipped])],
+            orelse=[ast.If(test=load(cond), body=node.body, orelse=node.orelse)],
+            finalbody=[],
