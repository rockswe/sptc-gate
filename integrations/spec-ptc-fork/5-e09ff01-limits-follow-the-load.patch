+def test_on_an_engine_that_queues_the_window_closes():
+    out, hist, eng = governed_turn(LOOP, {"waiting": 40}, w_init=16, w_max=64, w_min=2)
+    assert out.final_answer == "96"
+    moves = [e.data for e in hist if e.kind == "govern"]
+    assert moves and all(m["why"] == "queue" for m in moves)
+    assert moves[-1]["window"] < 16  # below the constant
+    assert eng.peak <= 16
