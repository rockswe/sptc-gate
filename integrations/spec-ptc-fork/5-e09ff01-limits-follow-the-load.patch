+TIMING = MockTiming(main_tok_per_s=2000, sub_base_s=0.2, sub_jitter_s=0.0, sub_tokens=2)
+CONTEXT = "\n".join(f"Q{i}: what is item number {i} ?" for i in range(96))
+LOOP = (
+    "questions = context.split('\\n')\n"
+    "labels = []\n"
+    "for q in questions:\n"
+    "    labels.append(llm_query('Classify: ' + q).strip())\n"
+    "answer['content'] = str(len(labels))\n"
+    "answer['ready'] = True"
+)
+
+
+class Counting(MockLM):
+    def __init__(self, timing=TIMING):
+        super().__init__(timing)
+        self.inflight = self.peak = 0
+        self._rec = threading.Lock()
+
+    def sub_call(self, prompt, _spec=None):
+        with self._rec:
+            self.inflight += 1
+            self.peak = max(self.peak, self.inflight)
+        try:
+            return super().sub_call(prompt, _spec=_spec)
+        finally:
+            with self._rec:
+                self.inflight -= 1
+
+
+def governed_turn(code, engine_metrics: dict, budget_kw: dict | None = None, **cfg):
+    eng = Counting()
+    bus = EventBus()
+    config = GovernorConfig(tick_s=0.05, **cfg)
+    probe = EngineProbe(fetch=lambda: metrics(**engine_metrics), every=0.05).start()
+    budget = Budget(max_inflight=config.w_init, max_window=config.w_max,
+                    max_dispatches_per_turn=4096, **(budget_kw or {}))
+    gov = Governor(budget, probe, None, bus, config)
+    h = Harness(eng, "spec", bus=bus, context=CONTEXT, scout=True, budget=budget)
+    try:
+        out = h.run_turn(eng.stream_main(f"go\n```repl\n{code}\n```\ndone"))
+    finally:
+        gov.close()
+        probe.stop()
+        h.launcher.shutdown()
+    return out, bus.history, eng
+
+
+def test_on_a_quiet_engine_the_window_opens_and_the_turn_is_faster_than_at_16():
+    out, hist, eng = governed_turn(LOOP, {}, w_init=4, w_max=64)
+    assert out.final_answer == "96"
+    k = [e.kind for e in hist]
+    assert k.count("claim_hit") == 96 and k.count("claim_miss") == 0
+    assert eng.peak > 16  # wider than the constant
+    assert out.metrics.t_turn < 96 / 16 * 0.2  # faster than 16 in flight would be: 1.2 s
+
