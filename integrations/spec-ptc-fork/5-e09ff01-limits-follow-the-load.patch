+def test_the_pools_own_calls_are_not_taken_for_everything_elses():
+    """A call shows in the engine's number once it is prefilled. From then on the pool
+    takes it off the reported use; before that it takes nothing off."""
+    clock = Clock()
+    eng, pool = pool_with(kv=0.20, clock=clock)
+    free = pool.capacity()
+    t = pool.acquire(100_000)
+    # the engine now reports the call too
+    seen = 0.20 + t.tokens / 154_816
+    eng.sample(dt=0.1, kv=seen)  # too early to be sure it is in the number: stays safe
+    assert pool.capacity() <= free
+    for _ in range(5):
+        eng.sample(dt=1.0, kv=seen)
+    assert pool.capacity() == pytest.approx(free, abs=64)
+    pool.release(t)
+    for _ in range(5):
+        eng.sample(dt=1.0, kv=0.20)
+    assert pool.capacity() == pytest.approx(free, abs=64)
