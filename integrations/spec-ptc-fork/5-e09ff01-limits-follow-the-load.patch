+            self.bus.emit(
+                "govern", window=new, was=w, why=why,
+                waiting=waiting, running=None if load is None else load.running,
+                kv=None if kv is None else round(kv, 3),
+                tax=None if tax is None else round(tax, 2),
+                cpu=None if cpu is None else round(cpu, 2),
+                pool=None if self.pool is None else self.pool.capacity())
+        return new
+
+    def close(self) -> None:
+        self.closed = True
+        _ticker.discard(self)
+
+
+def _weak_step(gov: Governor) -> Callable[[EngineLoad], object]:
+    """A probe listener that steps the governor while it lives and is open, without
+    keeping it alive: the probe is the process's, a governor its session's."""
+    ref = weakref.ref(gov)
+
+    def step(_load: EngineLoad) -> object:
+        g = ref()
+        if g is None or g.closed:
+            return False
+        g.tick()
+        return True
+
+    return step
+
+
+class _Ticker:
+    """One timer thread for every governor of the process that has no probe."""
+
+    def __init__(self) -> None:
+        self._govs: weakref.WeakSet = weakref.WeakSet()
+        self._lock = threading.Lock()
+        self._thread: threading.Thread | None = None
+
+    def add(self, gov: Governor) -> None:
+        with self._lock:
+            self._govs.add(gov)
+            if self._thread is None or not self._thread.is_alive():
+                self._thread = threading.Thread(target=self._run, daemon=True,
+                                                name="spec-governor")
+                self._thread.start()
+
+    def discard(self, gov: Governor) -> None:
+        with self._lock:
+            self._govs.discard(gov)
+
+    def _run(self) -> None:
+        while True:
+            with self._lock:
+                govs = list(self._govs)
+                if not govs:
+                    self._thread = None
+                    return
+            every = min(g.cfg.tick_s for g in govs)
+            t = time.perf_counter()
+            for g in govs:
+                try:
+                    g.tick()
+                except Exception:  # noqa: BLE001 - one session's failure stays its own
+                    pass
+            time.sleep(max(0.01, every - (time.perf_counter() - t)))
+
+
+_ticker = _Ticker()
