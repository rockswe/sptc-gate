+        if preempted:
+            hold = "preempted"
+        elif (waiting or 0) >= 1:
+            hold = "queue"
+        elif kv is not None and kv >= cfg.kv_high:
+            hold = "kv"
+        elif tax is not None and tax >= cfg.tax_hold:
+            hold = "tax"
+        elif cfg.cpu_hold is not None and cpu is not None and cpu >= cfg.cpu_hold:
+            hold = "cpu"
