+# --------------------------------------------------------------------------- the governor
+class Rig:
+    """A governor on a budget, with an engine and a clock the test moves."""
+
+    def __init__(self, **cfg) -> None:
+        self.clock = Clock()
+        self.eng = FakeEngine(clock=self.clock)
+        self.cpu = 0.0
+        self.cfg = GovernorConfig(**cfg)
+        self.budget = Budget(max_inflight=self.cfg.w_init, max_window=self.cfg.w_max)
+        self.bus = EventBus()
+        self.gov = Governor(self.budget, self.eng.probe, None, self.bus, self.cfg,
+                            clock=self.clock, cpu_clock=lambda: self.cpu, ticker=False)
+        self.demand = True
+        self.budget._slots = 1  # a call of this session is in flight
+        self.eng.sample()
+        self.gov.tick()
+
+    def tick(self, n: int = 1, cpu: float = 0.1, **engine) -> int:
+        for _ in range(n):
+            self.eng.sample(**engine)  # moves the clock by 0.25 s
+            self.cpu += cpu * 0.25
+            if self.demand:
+                self.budget._waited += 1  # a call had to wait for a place
+            w = self.gov.tick()
+        return w
+
+    def idle(self) -> None:
+        """No call waits for a place, and none is in flight."""
+        self.demand = False
+        self.budget._slots = 0
+
+    @property
+    def why(self) -> list[str]:
+        return [h[2] for h in self.gov.history]
+
