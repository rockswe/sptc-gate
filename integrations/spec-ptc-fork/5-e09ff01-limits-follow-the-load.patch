new file mode 100644
index 0000000..5610201
--- /dev/null
+++ b/tests/test_load.py
@@ -0,0 +1,917 @@
+"""Limits that follow the load (spec_ptc.engine.load).
+
+As shipped, speculation is held by two constants: 16 calls in flight and 120,000
+characters of prompts in flight. Measured on an H100 (2026-11-10) both were far below what
+the engine took. Here the window follows the engine's queue, KV cache and preemptions and
+the client's own CPU, and long prompts are admitted against the KV cache the engine has
+free. All mock: no network, no model; the "engine" is a text of metrics the test writes."""
+
+import threading
+import time
+
+import pytest
+
+from spec_ptc.contracts.events import EventBus
+from spec_ptc.contracts.tools import ToolRegistry
+from spec_ptc.engine.load import (
+    EngineLoad,
+    EngineProbe,
+    Governor,
+    GovernorConfig,
+    KvPool,
+    TaxMeter,
+    metrics_url,
+    parse_metrics,
+)
+from spec_ptc.engine.speculation import Budget, Launcher, SpecStore, make_scout_hooks
+from spec_ptc.runtime.engines import MockLM, MockTiming
+from spec_ptc.runtime.harness import Harness
+
+# what vLLM 0.32 writes (shortened), with two label sets for one gauge
+VLLM_TEXT = """\
+# HELP vllm:num_requests_running Number of requests in model execution batches.
+# TYPE vllm:num_requests_running gauge
+vllm:num_requests_running{engine="0",model_name="m"} 37.0
+vllm:num_requests_waiting{engine="0",model_name="m"} 4.0
+vllm:num_requests_waiting_by_reason{engine="0",model_name="m",reason="capacity"} 4.0
+vllm:kv_cache_usage_perc{engine="0",model_name="m"} 0.375
+vllm:num_preemptions_total{engine="0",model_name="m"} 2.0
+vllm:inter_token_latency_seconds_bucket{engine="0",le="0.01",model_name="m"} 0.0
+vllm:inter_token_latency_seconds_count{engine="0",model_name="m"} 1000.0
+vllm:inter_token_latency_seconds_sum{engine="0",model_name="m"} 45.0
+vllm:cache_config_info{block_size="16",cache_dtype="auto",engine="0",num_gpu_blocks="9676"} 1.0
+"""
+
+
+def metrics(running=0, waiting=0, kv=0.0, preempt=0, itl_sum=0.0, itl_count=0,
+            blocks=9676) -> str:
+    cache = (f'vllm:cache_config_info{{block_size="16",num_gpu_blocks="{blocks}"}} 1.0\n'
+             if blocks else "")
+    return (f'vllm:num_requests_running{{model_name="m"}} {running}\n'
+            f'vllm:num_requests_waiting{{model_name="m"}} {waiting}\n'
+            f'vllm:kv_cache_usage_perc{{model_name="m"}} {kv}\n'
+            f'vllm:num_preemptions_total{{model_name="m"}} {preempt}\n'
+            f'vllm:inter_token_latency_seconds_sum{{model_name="m"}} {itl_sum}\n'
+            f'vllm:inter_token_latency_seconds_count{{model_name="m"}} {itl_count}\n'
+            + cache)
+
+
+class Clock:
+    def __init__(self) -> None:
+        self.t = 100.0
+
+    def __call__(self) -> float:
+        return self.t
+
+
+class FakeEngine:
+    """Metrics text that a test sets; each read is a new sample."""
+
+    def __init__(self, clock=None, **kw) -> None:
+        self.kw = dict(kw)
+        self.clock = clock or Clock()
+        self.probe = EngineProbe(fetch=lambda: metrics(**self.kw), clock=self.clock)
+
+    def sample(self, dt: float = 0.25, **kw) -> EngineLoad:
+        self.kw.update(kw)
+        self.clock.t += dt
+        return self.probe.poll()
+
+
+# --------------------------------------------------------------------------- the probe
+def test_the_probe_reads_what_vllm_exports():
+    m = parse_metrics(VLLM_TEXT)
+    assert m["running"] == 37 and m["waiting"] == 4 and m["kv"] == 0.375
+    assert m["preemptions"] == 2 and m["kv_tokens"] == 9676 * 16
+    assert m["itl_sum"] == 45 and m["itl_count"] == 1000
+
+
+def test_older_metric_names_are_read_too():
+    m = parse_metrics("vllm:gpu_cache_usage_perc 0.5\nvllm:num_preemptions 3\n"
+                      "vllm:time_per_output_token_seconds_sum 2.0\n"
+                      "vllm:time_per_output_token_seconds_count 50\n")
+    assert m == {"kv": 0.5, "preemptions": 3.0, "itl_sum": 2.0, "itl_count": 50.0}
+
+
+def test_metrics_url_of_an_openai_base_url():
+    assert metrics_url("http://localhost:8210/v1") == "http://localhost:8210/metrics"
+    assert metrics_url("http://h:1/v1/") == "http://h:1/metrics"
+    assert metrics_url("http://h:1") == "http://h:1/metrics"
+
+
+def test_time_between_tokens_is_the_mean_since_the_last_sample():
+    eng = FakeEngine(itl_sum=10.0, itl_count=1000)
+    assert eng.sample().itl_ms is None  # nothing to compare with yet
+    load = eng.sample(itl_sum=10.0 + 100 * 0.040, itl_count=1100)
+    assert load.itl_ms == pytest.approx(40.0)
+    assert eng.sample(itl_sum=14.0 + 4 * 0.5, itl_count=1104).itl_ms is None  # too few tokens
+
+
+def test_the_tax_is_the_pace_now_over_the_quietest_pace_seen():
+    eng = FakeEngine(itl_sum=0.0, itl_count=0)
+    eng.sample()
+    s, n = 0.0, 0
+    for _ in range(6):  # a quiet engine: 40 ms a token
+        s, n = s + 100 * 0.040, n + 100
+        load = eng.sample(itl_sum=s, itl_count=n)
+    assert load.tax == pytest.approx(0.0, abs=0.02)
+    for _ in range(6):  # a loaded one: 100 ms a token
+        s, n = s + 100 * 0.100, n + 100
+        load = eng.sample(itl_sum=s, itl_count=n)
+    assert load.tax == pytest.approx(1.5, abs=0.1)
+
+
+def test_the_quiet_pace_follows_an_engine_that_got_slower_for_good():
+    m = TaxMeter(drift=0.01)
+    for _ in range(10):
+        m.add(40.0)
+    for _ in range(400):
+        m.add(60.0)
+    assert m.tax() == pytest.approx(0.0, abs=0.01)
+
+
+def test_a_sample_goes_stale_and_a_failed_read_gives_none():
+    clock = Clock()
+    eng = FakeEngine(clock=clock)
+    eng.sample()
+    assert eng.probe.latest() is not None
+    clock.t += 5.0
+    assert eng.probe.latest() is None
+
+    def down():
+        raise OSError("connection refused")
+
+    probe = EngineProbe(fetch=down)
+    assert probe.poll() is None and probe.errors == 1 and probe.latest() is None
+
+
+# --------------------------------------------------------------------------- the window
+def test_waiters_get_their_places_in_arrival_order_one_by_one():
+    b = Budget(max_inflight=1, max_window=8)
+    assert b.acquire_slots(1) == 1
+    order: list[int] = []
+
+    def want(i):
+        got = b.acquire_slots(1)
+        order.append(i)  # the only one in flight: nobody else writes now
+        time.sleep(0.02)
+        b.release_slots(got)
+
+    threads = []
+    for i in range(6):
+        t = threading.Thread(target=want, args=(i,))
+        t.start()
+        threads.append(t)
+        time.sleep(0.02)  # arrive in order
+    assert b.waiters() == 6 and b.take_waited() == 6 and b.take_waited() == 0
+    b.release_slots(1)
+    for t in threads:
+        t.join(2)
+    assert order == [0, 1, 2, 3, 4, 5]
+    assert b.waiters() == 0 and b.in_use() == 0
+
+
+def test_a_wider_window_lets_waiters_in_at_once_and_a_narrower_one_as_calls_end():
+    b = Budget(max_inflight=2, max_window=8)
+    b.acquire_slots(1)
+    b.acquire_slots(1)
+    got: list[int] = []
+    threads = [threading.Thread(target=lambda: got.append(b.acquire_slots(1)))
+               for _ in range(4)]
+    for t in threads:
+        t.start()
+    time.sleep(0.1)
+    assert got == [] and b.waiters() == 4
+    b.set_window(5)  # three more places: three of the four go
+    time.sleep(0.1)
+    assert got == [1, 1, 1] and b.waiters() == 1
+    b.set_window(2)  # narrower than what is in flight: nobody is stopped, nobody enters
+    for _ in range(3):
+        b.release_slots(1)
+    time.sleep(0.1)
+    assert b.waiters() == 1  # five were in flight, two are left: the window is full
+    b.release_slots(1)
+    for t in threads:
+        t.join(2)
+    assert got == [1, 1, 1, 1]
+
+
+def test_the_window_never_leaves_its_bounds():
+    b = Budget(max_inflight=16, max_window=64)
+    b.set_window(1000)
+    assert b.max_inflight == 64
+    b.set_window(0)
+    assert b.max_inflight == 1
+
+
+def test_a_batch_that_wants_more_than_the_window_takes_the_window_as_it_is_then():
+    b = Budget(max_inflight=4, max_window=64)
+    b.acquire_slots(1)
+    got: list[int] = []
+    t = threading.Thread(target=lambda: got.append(b.acquire_slots(20)))
+    t.start()
+    time.sleep(0.05)
+    b.set_window(32)  # it waited at a window of 4; it is let in at 32, with all 20
+    t.join(2)
+    assert got == [20]
+
+
+# --------------------------------------------------------------------------- the KV pool
+def pool_with(kv=0.0, clock=None, **kw):
+    eng = FakeEngine(clock=clock, kv=kv)
+    kw.setdefault("chars_per_token", 3.3)  # the arithmetic below is in these tokens
+    pool = KvPool(eng.probe, clock=eng.clock, **kw)
+    eng.sample()
+    return eng, pool
+
+
+def test_without_the_cache_size_the_pool_is_not_used():
+    eng = FakeEngine(blocks=0)
+    pool = KvPool(eng.probe, clock=eng.clock)
+    eng.sample()
+    assert not pool.live()
+    b = Budget(max_inflight_chars=1000, kv_pool=pool)
+    held = b.acquire_chars(400)
+    assert held == 400  # the session's own character budget, as shipped
+    b.release_chars(held)
+
+
+def test_a_call_is_admitted_against_the_kv_cache_the_engine_has_free():
+    eng, pool = pool_with(kv=0.50)  # half of 154,816 tokens held by everything else
+    assert pool.live()
+    free = int(0.88 * 154_816) - int(0.50 * 154_816)
+    assert pool.capacity() == free  # 58,830 tokens
+    a = pool.acquire(100_000)  # 30,304 tokens and a tenth for its answer
+    assert a.tokens == 30_304 + 3_030
+    done = threading.Event()
+    held: list = []
+
+    def second():
+        held.append(pool.acquire(100_000))
+        done.set()
+
+    threading.Thread(target=second, daemon=True).start()
+    assert not done.wait(0.3)  # two do not fit: the second waits, it is not refused
+    pool.release(a)
+    assert done.wait(2)
+    assert pool.in_flight() == held[0].tokens
+
+
+def test_a_token_is_counted_as_two_and_a_half_characters_unless_told_otherwise():
+    eng = FakeEngine()
+    pool = KvPool(eng.probe, clock=eng.clock)
+    assert pool.chars_per_token == 2.5
+    # OOLONG's chunks: 100,276 characters are 36,000 tokens, and their answers 4,096
+    assert pool.tokens_for(100_276) == 40_111 + 4_011
+    assert pool.tokens_for(100_276) >= 36_000 + 4_096
+
+
+def test_the_pool_grows_when_the_engine_empties():
+    eng, pool = pool_with(kv=0.80)
+    small = pool.capacity()
+    for _ in range(5):
+        eng.sample(kv=0.10)
+    assert pool.capacity() > small + 100_000
+
+
+def test_with_nothing_in_flight_a_call_of_any_size_is_admitted():
+    eng, pool = pool_with(kv=0.95)
+    assert pool.capacity() == 0
+    t = pool.acquire(400_000)  # there must be progress
+    assert pool.in_flight() == t.tokens
+
+
+def test_a_small_call_is_counted_but_never_held():
+    """The pool is one for all sessions. A session's long prompts must not stop the
+    others' short calls: how many of those are in flight is the window's business."""
+    eng, pool = pool_with(kv=0.50)
+    a = pool.acquire(180_000)  # nearly all of the room
+    t0 = time.perf_counter()
+    small = [pool.acquire(400) for _ in range(50)]  # 122 tokens and 64 for the answer
+    assert time.perf_counter() - t0 < 0.5
+    assert pool.in_flight() == a.tokens + 50 * (122 + 64)
+    done = threading.Event()
+    threading.Thread(target=lambda: (pool.acquire(100_000), done.set()), daemon=True).start()
+    assert not done.wait(0.3)  # a long one still waits
+    for t in small:
+        pool.release(t)
+    pool.release(a)
+    assert done.wait(2)
