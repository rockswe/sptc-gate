+        if busy and (preempted or (kv is not None and kv >= cfg.kv_crit)):
+            new, why = max(cfg.w_min, int(w * cfg.shrink_hard)), ("preempted" if preempted
+                                                                 else "kv")
+            self._ssthresh, self._queue_run = new, 0
+        elif busy and self._queue_run >= cfg.queue_samples:
+            new, why = max(cfg.w_min, int(w * cfg.shrink_queue)), "queue"
+            self._ssthresh, self._queue_run = new, 0
+        else:
+            if demand and hold is None and w < cfg.w_max:
+                if self._clear_run >= cfg.clear_samples:
+                    self._ssthresh = math.inf  # room for a while now: the cut is history
+                step = (max(1, int(w * (cfg.grow - 1))) if w < self._ssthresh
+                        else max(1, int(w * cfg.grow_add)))
+                new, why = min(cfg.w_max, w + step), "grow"
+            elif not demand and not busy and now - self._last_demand >= cfg.idle_s:
+                start = int(min(cfg.w_init, self._ssthresh))  # where the next burst starts
+                if w > start:
+                    new, why = max(start, int(w * 0.8)), "idle"
+                elif w < start and hold is None:
+                    new, why = min(start, w + max(1, w // 4)), "idle"
+        if new != w:
