index 0000000..8db52a2
--- /dev/null
+++ b/src/engine/load.py
@@ -0,0 +1,622 @@
+"""Limits that follow the load.
+
+spec-ptc as shipped holds speculation back with two constants: 16 calls in flight and
+120,000 characters of prompts in flight per session (speculation.Budget). Measured on one
+H100, both were far below what the engine took. On a small or a busy engine they can be
+too high. This module sets both from what the engine and the client report:
+
+- EngineProbe reads a vLLM server's /metrics: requests running and waiting, the KV
+  cache's size and how full it is, preemptions, and the time between two tokens.
+- KvPool, one per engine and process, admits speculative calls against the KV cache the
+  engine has free, in place of a count of characters per session.
+- Governor, one per session, moves the session's window (Budget.max_inflight) between
+  w_min and w_max: up while calls wait for a place and nothing says stop, down when the
+  engine queues, preempts or runs out of KV cache.
+
+The rule behind it: a call that is certain to be used has to be run anyway, and on an
+engine whose step time grows linearly with its batch, running it sooner does not cost the
+other requests more in total. What costs them is an engine that is past what it can admit:
+requests queue in front of the root's next turn, or the KV cache overflows and work is
+thrown away. So the window follows those signals, and a bound on how much slower tokens
+may get (tax_hold) only stops it from growing.
+
+Everything here is off unless asked for (SpecSession(governor=...))."""
+
+from __future__ import annotations
+
+import math
+import re
+import statistics
+import threading
+import time
+import urllib.request
+import weakref
+from collections import deque
+from collections.abc import Callable
+from dataclasses import dataclass
+
+from spec_ptc.contracts.events import NULL_BUS, EventBus
+
+
+# --------------------------------------------------------------------------- the engine
+@dataclass(frozen=True)
+class EngineLoad:
+    """One sample of what the engine reports. A field is None if the engine does not
+    export it."""
+
+    t: float  # perf_counter when it was read
+    running: float | None = None  # requests in the engine's batch
+    waiting: float | None = None  # requests the engine could not schedule in its last step
+    kv: float | None = None  # share of the KV cache in use
+    kv_tokens: int | None = None  # the KV cache's size, in tokens
+    preemptions: float | None = None  # running total
+    itl_ms: float | None = None  # mean time between two tokens since the last sample
+    tax: float | None = None  # itl_ms over the quietest pace seen lately, minus 1
+
+
+_LABEL = re.compile(r'(\w+)="([^"]*)"')
+_GAUGES = {
+    "running": ("num_requests_running",),
+    "waiting": ("num_requests_waiting",),
+    "kv": ("kv_cache_usage_perc", "gpu_cache_usage_perc"),
+}
+_COUNTERS = {
+    "preemptions": ("num_preemptions_total", "num_preemptions"),
+    "itl_sum": ("inter_token_latency_seconds_sum", "time_per_output_token_seconds_sum"),
+    "itl_count": ("inter_token_latency_seconds_count", "time_per_output_token_seconds_count"),
+}
+
+
+def parse_metrics(text: str) -> dict:
+    """What the governor reads, from a vLLM server's Prometheus text. A metric is summed
+    over its label sets (several engines behind one server); for a metric with two names
+    (older and newer vLLM) the first that is there wins."""
+    sums: dict[str, float] = {}
+    out: dict = {}
+    for line in text.splitlines():
+        if not line or line[0] == "#":
+            continue
+        head, _, value = line.rpartition(" ")
+        name = head.split("{", 1)[0].split(":", 1)[-1]
+        if name == "cache_config_info":
+            labels = dict(_LABEL.findall(head))
+            try:
+                blocks = int(float(labels["num_gpu_blocks"]))
+                size = int(float(labels["block_size"]))
+            except (KeyError, ValueError):
+                continue
+            out["kv_tokens"] = out.get("kv_tokens", 0) + blocks * size
+            continue
+        try:
+            sums[name] = sums.get(name, 0.0) + float(value)
+        except ValueError:
+            pass
+    for key, names in {**_GAUGES, **_COUNTERS}.items():
+        for name in names:
+            if name in sums:
+                out[key] = sums[name]
+                break
+    return out
+
+
+def metrics_url(base_url: str) -> str:
+    """The /metrics of the server behind an OpenAI base URL (http://host:port/v1)."""
+    root = base_url.rstrip("/")
+    if root.endswith("/v1"):
+        root = root[:-3]
+    return root.rstrip("/") + "/metrics"
+
+
+class TaxMeter:
+    """How much slower tokens come than at the quietest pace seen lately.
+
+    `add` takes a mean time between tokens. The pace now is the median of the last few;
+    the quiet pace is the lowest pace seen, let rise by `drift` per sample so that it
+    follows an engine that got slower for good (longer contexts, another host)."""
+
+    def __init__(self, window: int = 4, drift: float = 0.002) -> None:
+        self._recent: deque[float] = deque(maxlen=window)
+        self._drift = drift
+        self.base: float | None = None
+
+    def add(self, ms: float) -> None:
+        if not (ms > 0 and math.isfinite(ms)):
+            return
+        self._recent.append(ms)
+        now = statistics.median(self._recent)
+        self.base = now if self.base is None else min(now, self.base * (1 + self._drift))
+
+    def now(self) -> float | None:
+        return statistics.median(self._recent) if self._recent else None
+
+    def tax(self) -> float | None:
+        if not self._recent or not self.base:
+            return None
+        return statistics.median(self._recent) / self.base - 1.0
+
+
+class EngineProbe:
+    """A vLLM server's /metrics, read every `every` seconds on a thread of its own.
+
+    `fetch` returns the metrics text (tests pass their own). A read that fails leaves the
+    last sample to go stale: latest() then returns None and whoever asks keeps its limits
+    where they are."""
+
+    MIN_TOKENS = 8  # fewer tokens than this between two samples: no time between tokens
+
+    def __init__(self, url: str = "", every: float = 0.25, timeout: float = 2.0,
+                 fetch: Callable[[], str] | None = None,
+                 clock: Callable[[], float] = time.perf_counter) -> None:
+        self.url, self.every = url, every
+        self._fetch = fetch or (
+            lambda: urllib.request.urlopen(url, timeout=timeout).read().decode())
+        self._clock = clock
+        self._lock = threading.Lock()
+        self._latest: EngineLoad | None = None
+        self._itl_prev: tuple[float, float] | None = None
+        self._meter = TaxMeter()
+        self._listeners: list[Callable[[EngineLoad], None]] = []
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+        self.samples = self.errors = 0
+
+    def listen(self, fn: Callable[[EngineLoad], object]) -> None:
+        """Call `fn` with every new sample, on the probe's thread. A listener that
+        returns False is dropped."""
+        with self._lock:
+            self._listeners.append(fn)
+
+    def poll(self) -> EngineLoad | None:
+        """Read the engine once. Returns the sample, or None if the read failed."""
+        try:
+            m = parse_metrics(self._fetch())
+        except Exception:  # noqa: BLE001 - an engine that is down, a timeout: no sample
+            self.errors += 1
+            return None
+        itl = None
+        if "itl_sum" in m and "itl_count" in m:
+            prev, self._itl_prev = self._itl_prev, (m["itl_sum"], m["itl_count"])
+            if prev is not None and m["itl_count"] - prev[1] >= self.MIN_TOKENS:
+                itl = 1000.0 * (m["itl_sum"] - prev[0]) / (m["itl_count"] - prev[1])
+                self._meter.add(itl)
+        load = EngineLoad(
+            t=self._clock(), running=m.get("running"), waiting=m.get("waiting"),
+            kv=m.get("kv"), kv_tokens=m.get("kv_tokens"), preemptions=m.get("preemptions"),
+            itl_ms=itl, tax=self._meter.tax() if itl is not None else None)
+        with self._lock:
+            self._latest = load
+            self.samples += 1
+            listeners = list(self._listeners)
+        for fn in listeners:
+            try:
+                keep = fn(load)
+            except Exception:  # noqa: BLE001 - a listener must not stop the probe
+                keep = True
+            if keep is False:
+                with self._lock:
+                    if fn in self._listeners:
+                        self._listeners.remove(fn)
+        return load
+
+    def latest(self, max_age: float = 2.0) -> EngineLoad | None:
+        with self._lock:
+            load = self._latest
+        if load is None or self._clock() - load.t > max_age:
+            return None
+        return load
+
+    def start(self) -> EngineProbe:
+        with self._lock:
+            if self._thread is None:
+                self._thread = threading.Thread(target=self._run, daemon=True,
+                                                name="spec-probe")
+                self._thread.start()
+        return self
+
+    def _run(self) -> None:
+        while not self._stop.is_set():
+            t = time.perf_counter()
+            self.poll()
+            self._stop.wait(max(0.01, self.every - (time.perf_counter() - t)))
+
+    def stop(self) -> None:
+        self._stop.set()
+
+
+_shared_lock = threading.Lock()
+_probes: dict[str, EngineProbe] = {}
+_pools: weakref.WeakKeyDictionary = weakref.WeakKeyDictionary()
+
+
+def probe_for(url: str, every: float = 0.25) -> EngineProbe:
+    """The one probe of this process for that /metrics URL, started."""
+    with _shared_lock:
+        probe = _probes.get(url)
+        if probe is None:
+            probe = _probes[url] = EngineProbe(url, every=every)
+    return probe.start()
+
+
+def pool_for(probe: EngineProbe, **kw) -> KvPool:
+    """The one KV pool of this process for that probe's engine."""
+    with _shared_lock:
+        pool = _pools.get(probe)
+        if pool is None:
+            pool = _pools[probe] = KvPool(probe, **kw)
+    return pool
+
+
+# --------------------------------------------------------------------------- the KV cache
+class KvTicket:
+    __slots__ = ("tokens", "t", "visible_at")
+
+    def __init__(self, tokens: int, t: float, visible_at: float) -> None:
+        self.tokens, self.t, self.visible_at = tokens, t, visible_at
+
+
+class KvPool:
+    """The KV cache the engine has free, shared by the speculative calls of every governed
+    session of this process.
+
+    As shipped, a session keeps at most 120,000 characters of speculative prompts in
+    flight: about a quarter of an H100's KV cache with a 30B model, and half of a T4's
+    with a 1.7B one. Here a call is admitted if its prompt, plus room for its answer,
+    fits into `target` of the engine's KV cache less what everything else holds. The
+    engine says how large the cache is and how full; what the pool's own calls hold is
+    estimated from their characters, and what is left of the reported use is everything
+    else's.
+
+    The client has no tokenizer. It counts `chars_per_token` characters to a token: 2.5,
+    on the low side on purpose. Prose runs at 3.5 to 4 and is then taken for larger than
+    it is, which admits less than would fit. Text full of numbers and identifiers runs
+    near 2.8 (measured on OOLONG: 100,276 characters, 36,000 tokens), and a count of 3.3
+    would have admitted a fifth more of it than the cache holds.
+
+    A call's tokens show in the engine's number only once it has been prefilled, so a
+    call counts as seen `visible_s` after it was admitted, plus the time its prefill
+    takes. Until then the reported use is taken to hold none of it. That errs to the
+    safe side: it can only make everything else look larger.
+
+    A call that does not fit waits (acquire blocks); it is never refused. Three kinds of
+    call do not wait:
+
+    - With nothing of the pool's in flight, a call is admitted whatever its size, so
+      there is always progress.
+    - A small call (at most `small_share` of the cache) is counted but never held: the
+      pool is one for all sessions, and one session's long prompts must not stop the
+      others' short calls. How many short calls are in flight is the window's business.
+    - A call somebody is waiting for (`urgent`): the real run at its claim, or the
+      shadow where a statement uses the result. It is not ahead of need any more: the
+      program itself would send it now, and the real run cannot start before the shadow
+      is through. So the pool never makes a session slower than it is without
+      speculation, and one session's long calls never hold up another session's turn.
+
+    Without the cache's size from the engine the pool admits nothing itself: live() is
+    False and the session's own character budget applies."""
+
+    def __init__(self, probe: EngineProbe, target: float = 0.88,
+                 chars_per_token: float = 2.5, answer_share: float = 0.10,
+                 answer_min_tokens: int = 64, visible_s: float = 0.5,
+                 prefill_tokens_per_s: float = 20_000.0, small_share: float = 0.01,
+                 clock: Callable[[], float] = time.perf_counter) -> None:
+        self.probe = probe
+        self.target = target
+        self.chars_per_token = chars_per_token
+        self.answer_share, self.answer_min_tokens = answer_share, answer_min_tokens
+        self.visible_s, self.prefill_tokens_per_s = visible_s, prefill_tokens_per_s
+        self.small_share = small_share
+        self._kv_tokens: int | None = None
+        self._clock = clock
+        self._cv = threading.Condition()
+        self._held: set[KvTicket] = set()
+        self._total = 0
+        self._others: deque[int] = deque(maxlen=5)
+        self._capacity: int | None = None
+        self.waited = 0  # calls that had to wait for room
+        probe.listen(self._on_sample)
+
+    def tokens_for(self, nchars: int) -> int:
+        prompt = math.ceil(nchars / self.chars_per_token)
+        return prompt + max(self.answer_min_tokens, int(prompt * self.answer_share))
+
+    def _on_sample(self, load: EngineLoad) -> None:
+        if load.kv is None or not load.kv_tokens:
+            return
+        with self._cv:
+            now = self._clock()
+            self._kv_tokens = load.kv_tokens
+            seen = sum(t.tokens for t in self._held if t.visible_at <= now)
+            self._others.append(max(0, int(load.kv * load.kv_tokens) - seen))
+            others = int(statistics.median(self._others))
+            self._capacity = max(0, int(self.target * load.kv_tokens) - others)
+            self._cv.notify_all()
+
+    def live(self) -> bool:
+        """Does the engine say how large its KV cache is and how full, recently?"""
+        load = self.probe.latest()
+        return load is not None and load.kv is not None and bool(load.kv_tokens)
+
+    def capacity(self) -> int | None:
+        """Tokens of KV cache the pool's calls may hold now (None: not known)."""
+        with self._cv:
+            return self._capacity
+
+    def in_flight(self) -> int:
+        with self._cv:
+            return self._total
+
+    def acquire(self, nchars: int, timeout: float = 600.0, calls: int = 1,
+                urgent: Callable[[], bool] | None = None) -> KvTicket:
+        """Room for `calls` calls of `nchars` characters together (a batch's calls in
+        flight). `urgent` says whether the program is waiting for one of them by now."""
+        calls = max(1, calls)
+        each = self.tokens_for(math.ceil(nchars / calls))
+        need = each * calls
+        deadline = time.monotonic() + timeout
+        with self._cv:
+            waited = False
+            while (self._total > 0 and self._capacity is not None
+                   and self._total + need > self._capacity):
+                if self._kv_tokens and each <= self.small_share * self._kv_tokens:
+                    break  # small calls are counted, not held
+                if urgent is not None and urgent():
+                    break  # the program waits for it: it would send it itself now
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    break  # degrade: run anyway, as the character budget does
+                if not waited:
+                    waited = True
+                    self.waited += 1
+                self._cv.wait(min(remaining, 0.1))
+            now = self._clock()
+            ticket = KvTicket(need, now, now + self.visible_s
+                              + need / self.prefill_tokens_per_s)
+            self._held.add(ticket)
+            self._total += need
+            return ticket
+
+    def release(self, ticket: KvTicket) -> None:
+        with self._cv:
+            if ticket in self._held:
+                self._held.discard(ticket)
+                self._total -= ticket.tokens
+                self._cv.notify_all()
+
+
+# --------------------------------------------------------------------------- the window
+@dataclass
+class GovernorConfig:
+    w_init: int = 16  # where the window starts: spec-ptc's constant
+    w_min: int = 1
+    w_max: int = 256  # also the size of the launcher's thread pool
+    tick_s: float = 0.25
+    grow: float = 1.5  # per tick, until something first says stop
+    grow_add: float = 0.125  # after that: this share of the window per tick
+    shrink_queue: float = 0.7  # the engine has a standing queue
+    shrink_hard: float = 0.5  # the engine preempted, or its KV cache is nearly full
+    # A standing queue: in queue_samples samples in a row the engine had at least
+    # queue_share of its running requests waiting, and at least queue_min. A root's next
+    # turn waits behind that queue for about queue_share of a sub-call's time. Fewer
+    # waiting than that keep the engine's places full and are left alone.
+    queue_samples: int = 3
+    queue_share: float = 0.25
+    queue_min: int = 2
+    clear_samples: int = 3  # samples in a row with nothing waiting: growth by `grow` again
+    kv_high: float = 0.93  # no growth above this share of the KV cache
+    kv_crit: float = 0.97  # above this the window is halved
+    tax_hold: float = 1.0  # no growth while tokens take (1 + tax_hold) times their quiet time
+    # No growth while this process uses that much of one core (None: not looked at, the
+    # default). A client at its limit launches no faster with a wider window, but calls it
+    # has sent still run in the engine, and where the launcher is what is slow no call
+    # waits for a place, so the window does not grow anyway. The number is in every event.
+    cpu_hold: float | None = None
+    idle_s: float = 2.0  # this long with no call waiting or in flight: back towards w_init
+    root_gaps: int = 16  # root deltas per sample of the root's own pace (no engine pace)
+
+
+class Governor:
+    """One session's window, moved by what the engine and the client report.
+
+    One control step per new sample of the engine (the probe calls it); without a probe,
+    one every tick_s on a timer thread. Tests call tick() themselves. Each step:
+
+    1. The engine preempted since the last tick, or its KV cache is above kv_crit: the
+       window is halved.
+    2. The engine had a standing queue (a quarter of what it runs waiting, in
+       queue_samples samples in a row): the window is cut to shrink_queue of itself. A
+       request or two waiting only stop growth: that is an engine with its places full,
+       or a burst arriving between two steps.
+       Both cuts apply to a session with calls in flight only: one that has none is not
+       what loads the engine, and keeps its window for when it has.
+    3. Otherwise, if calls waited for a place since the last tick and nothing holds it
+       (a request waiting, KV above kv_high, tokens slower than tax_hold allows), the
+       window grows: by `grow` until the first cut, by `grow_add` of itself after it, as
+       a TCP window does. After clear_samples samples in a row with nothing waiting the
+       cut is forgotten and growth is by `grow` again: the engine has room now.
+    4. With no call waiting for a place and none in flight for idle_s, the window goes
+       back towards where the next burst should start: w_init, or where the last cut
+       left it if that is lower. An engine that queued at 12 is not offered 16 again.
+
+    Without a probe only the client's own signal applies (the root's token pace, through
+    note_root): the window then knows nothing of the engine's queue or KV cache, and
+    w_max is its only bound from that side."""
+
+    def __init__(self, budget, probe: EngineProbe | None = None, pool: KvPool | None = None,
+                 bus: EventBus = NULL_BUS, config: GovernorConfig | None = None,
+                 clock: Callable[[], float] = time.perf_counter,
+                 cpu_clock: Callable[[], float] = time.process_time,
+                 ticker: bool = True) -> None:
+        self.budget, self.probe, self.pool, self.bus = budget, probe, pool, bus
+        self.cfg = config or GovernorConfig()
+        self._clock, self._cpu_clock = clock, cpu_clock
+        self._lock = threading.Lock()
+        self._ssthresh = math.inf
+        self._queue_run = 0
+        self._clear_run = 0
+        self._last_sample_t: float | None = None
+        self._last_preempt: float | None = None
+        self._last_demand = clock()
+        self._cpu_prev: tuple[float, float] | None = None
+        self._root = TaxMeter()
+        self._root_t: list[float] = []
