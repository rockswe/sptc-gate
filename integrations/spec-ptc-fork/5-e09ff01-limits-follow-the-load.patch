+def test_a_batch_has_no_more_calls_in_flight_than_the_window_gave_it():
+    """A batch of 12 that the tool would run all at once, at a window of 4: it goes out
+    in three pieces, one after another."""
+    lock = threading.Lock()
+    state = {"now": 0, "peak": 0}
+    seen: list[int] = []
+
+    def batched(prompts):
+        with lock:
+            seen.append(len(prompts))
+            state["now"] += len(prompts)
+            state["peak"] = max(state["peak"], state["now"])
+        time.sleep(0.05)
+        with lock:
+            state["now"] -= len(prompts)
+        return [f"many({p})" for p in prompts]
+
+    reg, bus, store, launcher = launcher_with(batched, max_inflight=16, chunk=32)
+    held = launcher.budget.acquire_slots(16)  # the window is full: the batch will wait
+    make_scout_hooks(reg, launcher)["llm_query_batched"]([f"p{i}" for i in range(12)])
+    time.sleep(0.05)
+    launcher.budget.set_window(4)  # cut after the batch was announced as one request
+    launcher.budget.release_slots(held)
+    wait_all(store)
+    assert seen == [4, 4, 4] and state["peak"] == 4
+    assert [s.result for s in store.all] == [f"many(p{i})" for i in range(12)]
+    launcher.shutdown()
+
+
+def test_the_first_chunk_runs_while_the_rest_is_still_being_announced():
+    started = threading.Event()
+
+    def batched(prompts):
+        started.set()
+        return list(prompts)
+
+    reg, bus, store, launcher = launcher_with(batched, max_inflight=64, chunk=4)
+    seen_started: list[bool] = []
+    bus.subscribe(lambda ev: (time.sleep(0.01), seen_started.append(started.is_set()))
+                  if ev.kind == "dispatch" else None)
+    make_scout_hooks(reg, launcher)["llm_query_batched"]([f"p{i}" for i in range(40)])
+    wait_all(store)
+    assert seen_started[0] is False and seen_started[-1] is True
+    launcher.shutdown()
+
+
+def test_a_call_evicted_while_it_waits_for_a_place_is_not_sent():
+    """With a governed window the pool has more threads than the window has places, so a
+    launched call can be waiting for its place when its turn ends."""
+    sent: list[str] = []
+    gate = threading.Event()
+
+    def single(p):
+        sent.append(p)
+        gate.wait(5)
+        return p
+
+    def batched(prompts):
+        sent.extend(prompts)
+        return list(prompts)
+
+    reg = ToolRegistry()
+    reg.register("llm_query", single, speculatable=True, pure=True)
+    reg.register("llm_query_batched", batched, speculatable=True, pure=True, batched=True)
+    bus = EventBus()
+    store = SpecStore(bus)
+    launcher = Launcher(store, bus, Budget(max_inflight=1, max_window=8), batch_launch=True)
+    scout = make_scout_hooks(reg, launcher)
+    scout["llm_query"]("holds the only place")
+    scout["llm_query"]("waits for it")
+    scout["llm_query_batched"](["b1", "b2"])
+    time.sleep(0.1)
+    assert sent == ["holds the only place"] and launcher.budget.waiters() == 2
+    store.evict_unclaimed("turn_end")
+    gate.set()
+    wait_all(store)
+    time.sleep(0.1)
+    assert sent == ["holds the only place"]  # nothing of what was evicted went out
+    assert launcher.budget.in_use() == 0 and launcher.budget.waiters() == 0
+    launcher.shutdown()
+
+
+def test_without_a_chunk_size_a_batch_is_one_call_as_before():
+    seen: list[int] = []
+
+    def batched(prompts):
+        seen.append(len(prompts))
+        return list(prompts)
+
+    reg, bus, store, launcher = launcher_with(batched, max_inflight=16)
+    make_scout_hooks(reg, launcher)["llm_query_batched"]([f"p{i}" for i in range(40)])
+    wait_all(store)
+    assert seen == [40]
+    launcher.shutdown()
+
+
+def test_everything_is_off_unless_asked_for():
+    from spec_ptc.speculator import SpecSession
+
+    s = SpecSession(ToolRegistry())
+    b = s.launcher.budget
+    assert s.governor is None and b.kv_pool is None
+    assert b.max_inflight == b.max_window == 16 and b.max_inflight_chars == 120_000
+    assert s.launcher.batch_chunk == 0
+    s.close()
+    g = SpecSession(ToolRegistry(), govern=True)
+    assert g.governor is not None and g.launcher.budget.max_window == 256
+    assert g.launcher.budget.max_inflight == 16  # it starts where spec-ptc ships
+    g.close()
+    assert g.governor.closed
diff --git a/tests/test_rlm_adapter.py b/tests/test_rlm_adapter.py
index 0551a39..3cc2659 100644
--- a/tests/test_rlm_adapter.py
+++ b/tests/test_rlm_adapter.py
@@ -303,3 +303,109 @@ def test_follow_window_resizes_the_handlers_listen_queue():
     repl.follow_window(h)  # once per turn: the queue is resized once per handler
     assert h._server.socket.backlogs == [256]
     assert h.batch_max_concurrent == 16  # batches stay as rlms runs them without batch launch
+
+
+# ---------------------------------------------------------------- limits that follow the load
+def _quiet_engine(**kw):
+    """A probe on a text of metrics: an engine with nothing waiting and an empty KV cache."""
+    from spec_ptc.engine.load import EngineProbe
+
+    vals = {"running": 0, "waiting": 0, "kv": 0.0, **kw}
+    text = lambda: (  # noqa: E731
+        f"vllm:num_requests_running {vals['running']}\n"
+        f"vllm:num_requests_waiting {vals['waiting']}\n"
+        f"vllm:kv_cache_usage_perc {vals['kv']}\n"
+        'vllm:cache_config_info{block_size="16",num_gpu_blocks="9676"} 1.0\n')
+    return EngineProbe(fetch=text, every=0.05).start()
+
+
+def test_adapter_governed_window_opens_on_a_quiet_engine_and_starts_at_16():
+    from demo.rlm import SpeculativeLocalREPL
+    from spec_ptc.engine.load import GovernorConfig
+
+    inflight = {"now": 0, "peak": 0}
+    lock = __import__("threading").Lock()
+
+    def counting(prompt, model=None):
+        with lock:
+            inflight["now"] += 1
+            inflight["peak"] = max(inflight["peak"], inflight["now"])
+        time.sleep(0.2)
+        with lock:
+            inflight["now"] -= 1
+        return "x"
+
+    code = (
+        "out = []\n"
+        "for i in range(120):\n"
+        "    out.append(llm_query('q' + str(i)).strip())\n"
+        "answer['content'] = str(len(out))\n"
+        "answer['ready'] = True"
+    )
+    probe = _quiet_engine()
+    repl = SpeculativeLocalREPL(
+        context_payload="ctx", subcall_override=counting, auto_speculate=False,
+        spec_scout=True, spec_govern=GovernorConfig(tick_s=0.05, w_max=64),
+        spec_load_url=probe)
+    try:
+        assert repl.session.launcher.budget.max_inflight == 16
+        r, wall = _drive(repl, code)
+    finally:
+        repl.session.close()
+        probe.stop()
+    assert r.final_answer == "120"
+    assert 16 < inflight["peak"] <= 64
+    assert wall < 120 / 16 * 0.2  # faster than the constant allows: 1.5 s
+    moves = [e.data for e in repl.bus.history if e.kind == "govern"]
+    assert moves and moves[0]["was"] == 16 and moves[0]["why"] == "grow"
+    assert not any(e.kind in ("claim_miss", "evict") for e in repl.bus.history)
+
+
+def test_adapter_sends_a_large_batch_in_chunks():
+    from demo.rlm import SpeculativeLocalREPL
+
+    backend = BatchBackend()
+    code = (
+        "out = llm_query_batched(['label: ' + str(i) for i in range(40)])\n"
+        "answer['content'] = str(len(out))\n"
+        "answer['ready'] = True"
+    )
+    repl = SpeculativeLocalREPL(
+        context_payload="ctx", subcall_override=slow_mock_llm,
+        subcall_batched_override=backend, auto_speculate=False,
+        spec_scout=True, spec_batch_launch=True, spec_batch_chunk=8, spec_max_inflight=16)
+    r, wall = _drive(repl, code)
+    assert r.final_answer == "40"
+    assert sorted(len(b) for b in backend.batches) == [8] * 5
+    assert sum(e.kind == "claim_hit" for e in repl.bus.history) == 40
+    assert not any(e.kind in ("claim_miss", "evict") for e in repl.bus.history)
+    assert 3 * 0.3 * 0.9 < wall < 5 * 0.3  # two chunks at a time: three rounds, not five
+
+
+def test_follow_window_of_a_governed_repl_fits_the_handler_to_the_widest_window():
+    from demo.rlm import SpeculativeLocalREPL
+
+    class Sock:
+        def __init__(self):
+            self.backlogs = []
+
+        def listen(self, n):
+            self.backlogs.append(n)
+
+    class Handler:
+        batch_max_concurrent = 16
+
+        def __init__(self):
+            self._server = type("S", (), {"socket": Sock()})()
+
+    h = Handler()
+    repl = SpeculativeLocalREPL(context_payload="ctx", spec_govern=True,
+                                spec_batch_launch=True, spec_batch_chunk=32)
+    try:
+        repl.follow_window(h)
+        assert h._server.socket.backlogs == [512]  # twice the widest window, 256
+        # a request to the handler holds one chunk: the handler is as wide as a chunk
+        assert h.batch_max_concurrent == 32
+        assert repl.reg.get("llm_query_batched").batch_width == 32
+    finally:
+        repl.session.close()
diff --git a/tests/test_scout_past.py b/tests/test_scout_past.py
new file mode 100644
index 0000000..17b7e3b
--- /dev/null
+++ b/tests/test_scout_past.py
@@ -0,0 +1,260 @@
+"""The scout goes on past a test that cannot leave its loop (scout="past").
+
+The scout places no bets: where an `if` needs a result that is not there yet it stops,
+and with it the loop the `if` is in. Recorded on OOLONG (2026-11-10): a loop of 160
+batches that counts each label with `if label == 'location':`. Neither spec-ptc as
+shipped nor the scout launched those batches ahead (80 s in one session), although every
+one of them is certain: no arm of the test can leave the loop.
+
+With scout="past" such a test is passed: neither arm runs in the scout, and the names
+an arm sets are unknown from there on. All mock: no network, no model."""
+
+import ast
+import re
+
+import pytest
+
+from spec_ptc.contracts.events import EventBus
+from spec_ptc.engine.shadow import scout_past_tests
+from spec_ptc.runtime.engines import MockLM, MockTiming
+from spec_ptc.runtime.harness import Harness
+
+TIMING = MockTiming(main_tok_per_s=2000, sub_base_s=0.25, sub_jitter_s=0.1, sub_tokens=3)
+CONTEXT = "\n".join(f"Q{i}: what is item number {i} ?" for i in range(24))
+
+
+def norm(s):
+    return re.sub(r"\[\w+#\d+\] ", "", s or "")
+
+
+def run_turn(code, mode="spec", scout="past", **kw):
+    eng = MockLM(TIMING)
+    bus = EventBus()
+    h = Harness(eng, mode, bus=bus, context=CONTEXT, scout=scout if mode == "spec" else False,
+                **kw)
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{code}\n```\ndone"))
+    h.launcher.shutdown()
+    return out, bus.history, h
+
+
+def kinds(history):
+    return [e.kind for e in history]
+
+
+def launched_before_first_answer(history) -> int:
+    n = 0
+    for e in history:
+        if e.kind == "ready":
+            break
+        n += e.kind == "dispatch"
+    return n
+
+
+def check_all_claimed(out, history, n, base):
+    k = kinds(history)
+    assert out.final_answer is not None and norm(out.final_answer) == norm(base.final_answer)
+    assert k.count("dispatch") == n and k.count("claim_hit") == n
+    assert k.count("claim_miss") == 0 and k.count("evict") == 0  # nothing missed or wasted
+
+
+# ------------------------------------------------------------------ the recorded shape
+COUNT_LABELS = (  # trec132k-17000237, turn 9, shortened
+    "lines = context.split('\\n')\n"
+    "batches = [lines[i:i+4] for i in range(0, len(lines), 4)]\n"
+    "count_a = 0\n"
+    "count_b = 0\n"
+    "for batch in batches:\n"
+    "    prompts = []\n"
+    "    for line in batch:\n"
+    "        prompts.append(f'Extract the label. Question: {line}')\n"
+    "    responses = llm_query_batched(prompts)\n"
+    "    for resp in responses:\n"
+    "        label = resp.strip()\n"
+    "        if label == 'location':\n"  # the test: neither client launched past it
+    "            count_a += 1\n"
+    "        elif label == 'abbreviation':\n"
+    "            count_b += 1\n"
+    "print(f'counts: {count_a}, {count_b}')\n"
+    "answer['content'] = str(count_a + count_b) + ' of ' + str(len(lines))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_loop_that_tests_each_result_launches_all_its_batches_at_once():
+    base, _, _ = run_turn(COUNT_LABELS, mode="baseline")
+    out, hist, _ = run_turn(COUNT_LABELS)
+    check_all_claimed(out, hist, 24, base)
+    assert launched_before_first_answer(hist) == 24
+    passed = [e.data.get("past") for e in hist if e.kind == "scout_exec" and e.data.get("past")]
+    assert passed == [24]  # the scout went past the test once per result, in one statement
+    # six batches of at least 0.25 s: one after another they need 1.5 s
+    assert out.metrics.t_turn < 1.0
+
+
+def test_as_built_before_the_scout_stops_at_the_test():
+    base, _, _ = run_turn(COUNT_LABELS, mode="baseline")
+    out, hist, _ = run_turn(COUNT_LABELS, scout=True)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    assert launched_before_first_answer(hist) == 4  # the first batch only
+    assert "needs a value" in [e.data.get("reason") for e in hist if e.kind == "scout_skip"]
+    assert out.metrics.t_turn > 1.5
+
+
+# ------------------------------------------------------------------ what it must not do
+SCAN_UNTIL_FOUND = (
+    "found = None\n"
+    "for q in context.split('\\n')[:6]:\n"
+    "    r = llm_query('Is this the one? ' + q)\n"
+    "    if 'item' in r:\n"
+    "        found = q\n"
+    "        break\n"  # this arm leaves the loop
+    "answer['content'] = str(found)\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_test_whose_arm_can_leave_the_loop_still_stops_the_scout():
+    """Whether the loop goes on depends on the answer. Launching the later iterations
+    would be a bet."""
+    base, _, _ = run_turn(SCAN_UNTIL_FOUND, mode="baseline")
+    out, hist, _ = run_turn(SCAN_UNTIL_FOUND)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    assert launched_before_first_answer(hist) == 1
+    assert kinds(hist).count("evict") == 0
+
+
+@pytest.mark.parametrize("leave", ["continue", "raise ValueError(r)", "assert False",
+                                   "return"])
+def test_every_way_out_of_an_arm_counts(leave):
+    body = ("for q in qs:\n    r = llm_query(q)\n    if r == 'x':\n        " + leave + "\n")
+    if leave == "return":
+        body = "def f(qs):\n" + "\n".join("    " + ln for ln in body.splitlines()) + "\n"
+    tree = scout_past_tests(ast.parse(body))
+    assert "__scout_stop__" not in ast.unparse(tree)  # left as it was
+
+
+CONDITIONAL_CALL = (
+    "out = []\n"
+    "for q in context.split('\\n')[:6]:\n"
+    "    a = llm_query('first: ' + q)\n"
+    "    if 'never' in a:\n"
+    "        a = llm_query('second: ' + q)\n"  # a call only one arm makes: a bet
+    "    out.append(a)\n"
+    "answer['content'] = str(len(out))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_call_inside_an_arm_is_not_launched():
+    base, _, _ = run_turn(CONDITIONAL_CALL, mode="baseline")
+    out, hist, _ = run_turn(CONDITIONAL_CALL)
+    check_all_claimed(out, hist, 6, base)  # the six first calls, no second one
+    assert launched_before_first_answer(hist) == 6
+    assert not any("second" in str(e.data.get("preview")) for e in hist if e.kind == "dispatch")
+
+
+NAME_SET_IN_AN_ARM = (
+    "style = 'short'\n"
+    "notes = []\n"
+    "for q in context.split('\\n')[:4]:\n"
+    "    r = llm_query('look at: ' + q)\n"
+    "    if 'item' in r:\n"
+    "        style = 'long'\n"
+    "    notes.append(llm_query('write a ' + style + ' note on: ' + q))\n"
+    "answer['content'] = str(len(notes))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_call_built_from_a_name_an_arm_sets_is_not_launched_with_the_old_value():
+    """`style` may be changed by the arm the scout did not run. A call built from it is
+    left to the shadow, which knows; it is not sent with the value from before."""
+    base, _, _ = run_turn(NAME_SET_IN_AN_ARM, mode="baseline")
+    out, hist, _ = run_turn(NAME_SET_IN_AN_ARM)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    k = kinds(hist)
+    assert k.count("evict") == 0 and k.count("claim_miss") == 0
+    previews = [str(e.data.get("preview")) for e in hist if e.kind == "dispatch"]
+    assert sum("look at" in p for p in previews) == 4
+    assert not any("short note" in p for p in previews)  # the mock's answers hold 'item'
+    scouted = [e for e in hist if e.kind == "dispatch" and e.data["source"] == "peek"]
+    assert len(scouted) == 4  # the four it could be sure of
+
+
+def test_a_test_the_scout_can_decide_runs_as_written():
+    code = (
+        "kept = []\n"
+        "for i, q in enumerate(context.split('\\n')[:6]):\n"
+        "    if i % 2 == 0:\n"  # known: no result in it
+        "        kept.append(llm_query('even: ' + q))\n"
+        "answer['content'] = str(len(kept))\n"
+        "answer['ready'] = True"
+    )
+    base, _, _ = run_turn(code, mode="baseline")
+    out, hist, _ = run_turn(code)
+    check_all_claimed(out, hist, 3, base)
+    assert launched_before_first_answer(hist) == 3
+    assert not [e for e in hist if e.kind == "scout_exec" and e.data.get("past")]
+
+
+def test_a_test_inside_a_function_is_left_alone():
+    """A name set inside a function is a local. Setting it from outside the `if` would
+    make the function's other reads of that name fail."""
+    src = (
+        "def tally(responses):\n"
+        "    n = 0\n"
+        "    for r in responses:\n"
+        "        if r == 'x':\n"
+        "            n += 1\n"
+        "    return n\n"
+    )
+    assert ast.unparse(scout_past_tests(ast.parse(src))) == ast.unparse(ast.parse(src))
+
+
+# ------------------------------------------------------------------ the rewrite itself
+def run_both(src: str, env: dict) -> tuple[dict, dict]:
+    a, b = dict(env), dict(env)
+    exec(compile(ast.parse(src), "<plain>", "exec"), a, a)
+    from spec_ptc.engine.speculation import ScoutStop, Unknown
+
+    b["__scout_stop__"], b["__scout_unknown__"] = ScoutStop, Unknown
+    exec(compile(scout_past_tests(ast.parse(src)), "<past>", "exec"), b, b)
+    keep = lambda d: {k: v for k, v in d.items() if not k.startswith("__")}  # noqa: E731
+    return keep(a), keep(b)
+
+
+@pytest.mark.parametrize("src", [
+    "n = 0\nfor x in xs:\n    if x > 2:\n        n += x\n    elif x == 1:\n        n -= 1\n"
+    "    else:\n        n += 100\n",
+    "out = []\nfor x in xs:\n    if x % 2:\n        if x > 3:\n            out.append(x)\n"
+    "        else:\n            out.append(-x)\n",
+    "seen = {}\nfor x in xs:\n    if x in seen:\n        seen[x] += 1\n    else:\n"
+    "        seen[x] = 1\n",
+    "n = 0\nwhile n < 3:\n    if n == 1:\n        n += 2\n    else:\n        n += 1\n",
+    "total = 0\nfor x in xs:\n    try:\n        if 10 // x > 2:\n            total += 1\n"
+    "    except ZeroDivisionError:\n        total -= 1\n",
+])
+def test_with_known_values_the_rewritten_statement_does_what_the_original_does(src):
+    plain, past = run_both(src, {"xs": [0, 1, 2, 3, 4, 5, 1]})
+    assert plain == past
+
+
+def test_with_an_unknown_value_neither_arm_runs_and_their_names_are_unknown():
+    from spec_ptc.engine.speculation import ScoutStop, Unknown
+
+    src = ("hits = 0\nlast = None\nseen = []\nfor r in rs:\n    if r == 'x':\n"
+           "        hits += 1\n        last = r\n    else:\n        seen.append(r)\n"
+           "    after = 1\n")
+    ns = {"rs": [Unknown(), Unknown()], "__scout_stop__": ScoutStop,
+          "__scout_unknown__": Unknown}
+    exec(compile(scout_past_tests(ast.parse(src)), "<past>", "exec"), ns, ns)
+    assert ns["after"] == 1  # the loop went on, twice
+    for name in ("hits", "last", "seen"):
+        assert isinstance(ns[name], Unknown), name
+
+
+def test_past_is_off_unless_asked_for():
+    out, hist, _ = run_turn(COUNT_LABELS, scout=True)
+    assert not [e for e in hist if e.data.get("past")]
+    out, hist, _ = run_turn(COUNT_LABELS, scout=False)
+    assert not [e for e in hist if e.kind.startswith("scout_")]
