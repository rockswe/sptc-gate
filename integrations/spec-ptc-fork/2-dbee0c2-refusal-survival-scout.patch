+    One gap: text assembled around it (an f-string, a join, a concatenation) is a plain
+    string. A test on such text is decided on the placeholder, so the scout may then
+    launch calls the real run does not make. That costs a wasted call, never a wrong
+    result: a call is only ever claimed by its exact arguments."""
+
+    __slots__ = ()
+
+    def __new__(cls):
+        return super().__new__(cls, UNKNOWN_TEXT)
+
+    def _stop(self, *a, **k):
+        raise ScoutStop()
+
+    __bool__ = __contains__ = __eq__ = __ne__ = __lt__ = __le__ = __gt__ = __ge__ = _stop
+
+    def __hash__(self):
+        return id(self)
+
+    def __iter__(self):
+        return iter(())
+
+    def __getitem__(self, k):
+        return Unknown()
+
+    def __getattribute__(self, name):
+        if name.startswith("__") and name.endswith("__"):
+            return str.__getattribute__(self, name)
+        return Unknown()  # .strip(), .lower(), .split(...): still not there
+
+
+def has_unknown(obj: Any, depth: int = 4) -> bool:
+    """Is an Unknown, or text made from one, anywhere in these arguments?"""
+    if isinstance(obj, (Unknown, UnknownStr)):
+        return True
+    if isinstance(obj, str):
+        return UNKNOWN_TEXT in obj
+    if depth <= 0:
+        return False
+    if isinstance(obj, (list, tuple, set, frozenset)):
+        return any(has_unknown(x, depth - 1) for x in obj)
+    if isinstance(obj, dict):
+        return any(has_unknown(k, depth - 1) or has_unknown(v, depth - 1)
+                   for k, v in obj.items())
+    return False
