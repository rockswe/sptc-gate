@@ -0,0 +1,107 @@
+"""V7: loop shapes recorded from real RLM runs (OOLONG, Qwen3-30B-A3B, 2026-11-09).
+
+In the earlier waves a call's result is used after the loop, so the shadow launches a
+loop's calls together. A model writing its own RLM code uses each result inside the
+loop: it parses it, counts it, extends a list with it. The shadow then stalls at every
+call, and calls that need nothing from each other go out one after another. In the
+recorded streaming runs that was 73% of the time still spent waiting after the stream.
+
+The three programs are the model's own, shortened and pointed at the suite's corpus.
+With the scout pass (SpecSession(scout=True)) every call should be in flight before the
+first one answers."""
+
+from benchmark.suite.patterns import PATTERNS, Pattern
+
+
+def _p(**kw):
+    PATTERNS.append(Pattern(**kw))
+
+
+def _answered(ns, n):
+    ans = ns.get("answer") or {}
+    return 1.0 if ans.get("ready") and str(ans.get("content")) == str(n) else 0.0
+
+
+_p(
+    name="rec_helper_loop",
+    category="hard",
+    n_expected_calls=16,
+    sub_max_tokens=24,
+    hypothesis=(
+        "A helper with a loop that splits each answer as soon as it has it. As shipped: "
+        "one call in flight at a time, no better than the baseline. With the scout: all "
+        "16 in flight before the first answer."
+    ),
+    code=(
+        "lines = context.split('\\n')\n"
+        "def create_prompt(batch):\n"
+        "    return 'In at most six words, what do these reports share? ' + ' / '.join(batch)\n"
+        "def classify_all(lines, batch_size=2):\n"
+        "    results = []\n"
+        "    for i in range(0, len(lines), batch_size):\n"
+        "        batch = lines[i:i + batch_size]\n"
+        "        prompt = create_prompt(batch)\n"
+        "        batch_results = llm_query(prompt).strip().split('\\n')\n"
+        "        results.extend(batch_results[:1])\n"
+        "        print(f'Processed batch {i//batch_size + 1}')\n"
+        "    return results\n"
+        "all_c = classify_all(lines, batch_size=2)\n"
+        "answer['content'] = str(len(all_c))\nanswer['ready'] = True"
+    ),
+    check=lambda ns: _answered(ns, 16),
+)
+
+_p(
+    name="rec_batched_counter",
+    category="hard",
+    n_expected_calls=32,
+    sub_max_tokens=8,
+    hypothesis=(
+        "Batches of four in a loop, each result counted before the next batch. As "
+        "shipped: one batch at a time. With the scout: all 32 calls in flight at once."
+    ),
+    code=(
+        "from collections import Counter\n"
+        "lines = context.split('\\n')\n"
+        "label_counts = Counter()\n"
+        "batch_size = 4\n"
+        "for i in range(0, len(lines), batch_size):\n"
+        "    batch = lines[i:i+batch_size]\n"
+        "    prompts = [f'One word, revenue, safety, latency or quality. Topic of: {q}' for q in batch]\n"
+        "    results = llm_query_batched(prompts)\n"
+        "    for r in results:\n"
+        "        label_counts[r] += 1\n"
+        "answer['content'] = str(sum(label_counts.values()))\nanswer['ready'] = True"
+    ),
+    check=lambda ns: _answered(ns, 32),
+)
+
+_p(
+    name="rec_try_loop",
+    category="hard",
+    n_expected_calls=8,
+    sub_max_tokens=48,
+    hypothesis=(
+        "A loop with the call inside try, the answer parsed right away, and a per-line "
+        "fallback in except. As shipped: one call at a time. With the scout: the 8 calls "
+        "at once, and none of the fallback's."
+    ),
+    code=(
+        "lines = context.split('\\n')\n"
+        "labels = []\n"
+        "for i in range(0, len(lines), 4):\n"
+        "    batch = lines[i:i + 4]\n"
+        "    prompt = ('For each report, one word for its topic, one per line:\\n' + '\\n'.join(batch))\n"
+        "    try:\n"
+        "        response = llm_query(prompt)\n"
+        "        batch_labels = [ln.strip() for ln in response.strip().split('\\n') if ln.strip()]\n"
+        "        labels.append(len(batch_labels))\n"
+        "        print(f'Processed batch {i//4 + 1}, first: {batch_labels[:1]}')\n"
+        "    except Exception as e:\n"
+        "        print(f'Error in batch: {e}')\n"
+        "        for q in batch:\n"
+        "            labels.append(llm_query(f'One word for the topic of: {q}').strip())\n"
+        "answer['content'] = str(len(labels))\nanswer['ready'] = True"
+    ),
+    check=lambda ns: _answered(ns, 8),
+)
