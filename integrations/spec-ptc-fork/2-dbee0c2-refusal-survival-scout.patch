+# --------------------------------------------------------------------------- the scout
+UNKNOWN_TEXT = "\x00spec-ptc:unknown\x00"  # what an Unknown looks like inside a string
+
+
+class ScoutStop(BaseException):
+    """The scout met something only a real value can decide: a test, a length, a number,
+    a comparison. Not an Exception, so model-written `except Exception` cannot catch it
+    and wander into its fallback path."""
+
+
+class Unknown:
+    """What a tool call returns in the scout pass: a result that is not there yet.
+
+    It absorbs what code usually does with a result (attribute access, calls, indexing,
+    arithmetic), iterates as empty, and turns into UNKNOWN_TEXT inside a string, so a
+    prompt built from it is recognisable. Anything that needs the real value to decide
+    (bool, int, a comparison, `in`) raises ScoutStop: the scout places no bets.
+
+    It has no __len__ on purpose. list(), extend() and join() ask an iterable for its
+    length first and must get "none" (a TypeError they swallow), not a stop. A direct
+    len() therefore raises TypeError, which ends the scout's statement like any error."""
+
+    __slots__ = ()
+
+    def _stop(self, *a, **k):
+        raise ScoutStop()
+
+    def _same(self, *a, **k):
+        return Unknown()
+
+    __bool__ = __int__ = __float__ = __index__ = __contains__ = _stop
+    __eq__ = __ne__ = __lt__ = __le__ = __gt__ = __ge__ = _stop
+    __call__ = __getitem__ = _same
+    __add__ = __radd__ = __sub__ = __rsub__ = __mul__ = __rmul__ = __mod__ = __rmod__ = _same
+    __truediv__ = __rtruediv__ = __floordiv__ = __rfloordiv__ = _same
+    __or__ = __ror__ = __and__ = __rand__ = _same
+
+    def __hash__(self):
+        return id(self)
+
+    def __str__(self):
+        return UnknownStr()
+
+    __repr__ = __str__
+
+    def __format__(self, spec):
+        return UNKNOWN_TEXT  # inside an f-string the text is all that survives
+
+    def __iter__(self):
+        return iter(())
+
+    def __length_hint__(self):
+        return 0
+
+    def __setitem__(self, k, v):
+        pass
+
+    def __getattr__(self, name):
+        if name.startswith("__") and name.endswith("__"):
+            raise AttributeError(name)
+        return Unknown()
+
+    def __await__(self):
+        return _identity(self).__await__()
+
+
+class UnknownStr(str):
+    """str() of an Unknown: text that is not there yet. It holds UNKNOWN_TEXT, so it
+    stays recognisable when pasted into a prompt, and a test on it stops the scout
+    (`'yes' in str(r)`, `str(r) == 'ok'`). Its methods return Unknown.
