+++ b/tests/test_refusal_survival.py
@@ -0,0 +1,250 @@
+"""A refused speculation must not end the turn's speculation.
+
+When the server refuses a speculative sub-call (SpeculationRejected) and the shadow needs
+its value, the call is re-run as normal work and the shadow keeps going. The real run then
+claims that re-run. A refused call is never sent as a bet a second time. All mock: no
+network, no model."""
+
+import re
+import string
+import threading
+import time
+
+import pytest
+
+from spec_ptc.contracts.events import EventBus
+from spec_ptc.contracts.hints import SpeculationRejected
+from spec_ptc.contracts.tools import ToolRegistry
+from spec_ptc.engine.speculation import (
+    Budget,
+    Launcher,
+    SpecStore,
+    SpecValue,
+    make_real_hooks,
+)
+from spec_ptc.runtime.engines import MockLM, MockTiming
+from spec_ptc.runtime.harness import Harness
+
+FAST = MockTiming(main_tok_per_s=2000, sub_base_s=0.15, sub_jitter_s=0.1, sub_tokens=3)
+SLOW_STREAM = MockTiming(main_tok_per_s=50, sub_base_s=0.15, sub_jitter_s=0.1, sub_tokens=3)
+CONTEXT = string.ascii_lowercase * 12
+
+
+class Refuser(MockLM):
+    """A server that refuses speculative sub-calls (all, or those `refuse` picks) after
+    `after` seconds. Records every call it receives."""
+
+    def __init__(self, timing=FAST, refuse=lambda prompt: True, after=0.05):
+        super().__init__(timing)
+        self.refuse, self.after = refuse, after
+        self.spec: list[str] = []  # speculative attempts, by prompt
+        self.real: list[str] = []  # normal calls, by prompt
+        self._rec = threading.Lock()
+
+    def sub_call(self, prompt, _spec=None):
+        with self._rec:
+            (self.real if _spec is None else self.spec).append(prompt)
+        if _spec is not None and self.refuse(prompt):
+            time.sleep(self.after)
+            raise SpeculationRejected("sptc_bet_rejected")
+        return super().sub_call(prompt, _spec=_spec)
+
+
+def norm(s):
+    return re.sub(r"\[\w+#\d+\] ", "", s or "")
+
+
+def run_turn(eng, mode, code):
+    bus = EventBus()
+    h = Harness(eng, mode, bus=bus, context=CONTEXT)
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{code}\n```\ndone"))
+    h.launcher.shutdown()
+    return out, [e.kind for e in bus.history], bus
+
+
+CHAIN = (
+    "a = llm_query('first: ' + context[:20])\n"
+    "b = llm_query('second: ' + str(a))\n"  # needs a: the shadow forces it here
+    "c = llm_query('third: ' + context[:10])\n"
+    "answer['content'] = str(a) + '|' + str(b) + '|' + str(c)\n"
+    "answer['ready'] = True"
+)
+
+
+# ------------------------------------------------------------------------- end to end
+def test_shadow_keeps_going_when_the_server_refuses_a_call_it_needs():
+    eng = Refuser()
+    out, kinds, _ = run_turn(eng, "spec", CHAIN)
+    base, _, _ = run_turn(MockLM(FAST), "baseline", CHAIN)
+    assert out.final_answer and norm(out.final_answer) == norm(base.final_answer)
+    assert "shadow_stop" not in kinds
+    assert kinds.count("shadow_exec") == 5  # every statement ran in the shadow
+    # each call was bet once, refused, and then run for real exactly once
+    assert sorted(eng.spec) == sorted(eng.real) and len(eng.real) == 3
+    assert kinds.count("spec_reissue") == 3
+    # the real run claimed those re-runs: it neither missed nor called again
+    assert kinds.count("claim_hit") == 3 and kinds.count("claim_miss") == 0
+    assert kinds.count("spec_fallback") == 0
+    assert out.metrics.reissues == 3 and out.metrics.hits == 3
+
+
+def test_calls_after_a_refused_one_are_still_speculated():
+    eng = Refuser(refuse=lambda p: p.startswith("first"))
+    out, kinds, _ = run_turn(eng, "spec", CHAIN)
+    base, _, _ = run_turn(MockLM(FAST), "baseline", CHAIN)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    assert "shadow_stop" not in kinds and kinds.count("spec_reissue") == 1
+    # only the refused call ran as normal work; the two after it ran as speculations
+    assert [p.split(":")[0] for p in eng.real] == ["first"]
+    assert sorted(p.split(":")[0] for p in eng.spec) == ["first", "second", "third"]
+    assert kinds.count("claim_hit") == 3 and kinds.count("claim_miss") == 0
+
+
+LOOP = (
+    "parts = [context[i:i+10] for i in range(0, 40, 10)]\n"
+    "outs = []\n"
+    "for p in parts:\n"
+    "    outs.append(llm_query('label: ' + p))\n"
+    "answer['content'] = '|'.join(str(o) for o in outs)\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_refused_peek_is_not_bet_again():
+    """The loop's calls are peeked while the model still writes the next line, and refused
+    at once. Neither a later peek pass nor the loop statement may send them again."""
+    eng = Refuser(SLOW_STREAM, after=0.0)
+    out, kinds, bus = run_turn(eng, "spec", LOOP)
+    base, _, _ = run_turn(MockLM(SLOW_STREAM), "baseline", LOOP)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    assert "shadow_stop" not in kinds
+    peeks = [e for e in bus.history if e.kind == "dispatch" and e.data["source"] == "peek"]
+    assert len(peeks) == 4  # the peek did fire, before the statement closed
+    assert len(eng.spec) == 4 and len(set(eng.spec)) == 4  # one bet per call
+    assert kinds.count("adopt") == 4  # the statement took the refused peeks over
+    assert sorted(eng.real) == sorted(eng.spec)  # each call ran for real once
+    assert kinds.count("claim_hit") == 4 and kinds.count("claim_miss") == 0
+
+
+# ------------------------------------------------------------------------- launcher
+def _launcher(max_dispatches=64):
+    """One tool whose first speculative call is refused; later ones succeed."""
+    reg = ToolRegistry()
+    calls: list[str] = []
+    lock = threading.Lock()
+
+    def fn(p, _spec=None):
+        with lock:
+            calls.append("real" if _spec is None else "spec")
+        if _spec is not None and _spec.seq == 1:
+            raise SpeculationRejected("sptc_bet_rejected")
+        return f"real({p})" if _spec is None else f"spec{_spec.seq}({p})"
+
+    fn.wants_spec = True
+    reg.register("llm_query", fn, speculatable=True, pure=True)
+    bus = EventBus()
+    store = SpecStore(bus)
+    launcher = Launcher(store, bus, Budget(max_dispatches_per_turn=max_dispatches))
+    return reg, bus, store, launcher, calls
+
+
+def test_reissue_takes_the_refused_calls_place_in_the_claim_order():
+    reg, bus, store, launcher, calls = _launcher()
+    tool = reg.get("llm_query")
+    s1 = launcher.dispatch(tool, ("p",), {}, "shadow")
+    s2 = launcher.dispatch(tool, ("p",), {}, "shadow")  # an identical call
+    assert s1.done.wait(2) and s2.done.wait(2)
+    assert str(SpecValue(s1)) == "real(p)"  # the shadow forces the refused one
+    assert s1.reissued is not None and s1.reissued.source == "reissue"
+    assert launcher.reissue(s1, tool) is s1.reissued  # once, whoever asks again
+    hooks = make_real_hooks(reg, store, launcher, bus)
+    assert hooks["llm_query"]("p") == "real(p)"  # first claim: the re-run, in s1's place
+    assert hooks["llm_query"]("p") == "spec2(p)"  # second claim: the second speculation
+    assert sorted(calls) == ["real", "spec", "spec"]  # nothing ran twice
+    kinds = [e.kind for e in bus.history]
+    assert kinds.count("spec_reissue") == 1 and kinds.count("claim_hit") == 2
+    launcher.shutdown()
+
+
+def test_reissue_counts_against_the_turns_dispatch_cap():
+    reg, bus, store, launcher, calls = _launcher(max_dispatches=1)
+    tool = reg.get("llm_query")
+    s1 = launcher.dispatch(tool, ("p",), {}, "shadow")  # uses the whole cap
+    assert s1.done.wait(2)
+    with pytest.raises(SpeculationRejected):  # so the shadow stops, as it did before
+        str(SpecValue(s1))
+    assert s1.reissued is None and calls == ["spec"]
+    launcher.shutdown()
+
+
+def test_a_refused_speculation_nobody_needed_is_a_plain_miss_and_leaves_at_turn_end():
+    reg, bus, store, launcher, calls = _launcher()
+    tool = reg.get("llm_query")
+    s1 = launcher.dispatch(tool, ("p",), {}, "shadow")
+    s2 = launcher.dispatch(tool, ("q",), {}, "shadow")
+    assert s1.done.wait(2) and s2.done.wait(2)
+    hooks = make_real_hooks(reg, store, launcher, bus)
+    assert hooks["llm_query"]("p") == "real(p)"  # never forced: the real run just calls
+    assert [e.kind for e in bus.history if e.kind.startswith(("claim", "spec_re"))] == [
+        "spec_rejected", "claim_miss"]
+    # a refused speculation left in the store goes at turn end, without an evict event
+    s3 = launcher.dispatch(tool, ("r",), {}, "shadow")
+    s3.error, s3.state = SpeculationRejected("x"), "failed"
+    assert store.evict_unclaimed("turn_end") == 1  # only q's finished speculation
+    assert all(len(q) == 0 for q in store._q.values())
+    assert [e.data["seq"] for e in bus.history if e.kind == "evict"] == [s2.seq]
+    launcher.shutdown()
+
+
+def test_deterministic_tool_reuses_the_reissued_run():
+    reg = ToolRegistry()
+    calls: list[str] = []
+
+    def lookup(k, _spec=None):
+        calls.append("real" if _spec is None else "spec")
+        if _spec is not None:
+            raise SpeculationRejected("sptc_bet_rejected")
+        return f"value({k})"
+
+    lookup.wants_spec = True
+    reg.register("lookup", lookup, speculatable=True, pure=True, deterministic=True)
+    bus = EventBus()
+    store = SpecStore(bus)
+    launcher = Launcher(store, bus)
+    tool = reg.get("lookup")
+    s1 = launcher.dispatch_or_adopt(tool, ("k",), {}, "shadow")
+    assert s1.done.wait(2)
+    assert launcher.dispatch_or_adopt(tool, ("k",), {}, "shadow") is s1  # no second bet
+    assert str(SpecValue(s1)) == "value(k)"
+    hooks = make_real_hooks(reg, store, launcher, bus)
+    assert hooks["lookup"]("k") == "value(k)" and hooks["lookup"]("k") == "value(k)"
+    assert calls == ["spec", "real"]  # one refused bet, one real run, shared by every use
+    launcher.shutdown()
+
+
+# ------------------------------------------------------------------------- peeks
+BATCHED_LOOP = (
+    "groups = [['a1: ' + context[:5], 'a2: ' + context[5:10]],"
+    " ['b1: ' + context[10:15], 'b2: ' + context[15:20]]]\n"
+    "outs = []\n"
+    "for group in groups:\n"
+    "    outs.extend(llm_query_batched(group))\n"
+    "answer['content'] = '|'.join(str(o) for o in outs)\n"
+    "answer['ready'] = True"
+)
+
+
+def test_peek_of_a_call_with_a_list_argument_does_not_end_the_shadow():
+    """While the model writes the line after the loop, the loop sits in the tail and the
+    peek unrolls it: one `llm_query_batched(group)` per group, each with a list argument.
+    Counting plans by their arguments raised TypeError there, which ended the shadow
+    thread, so the turn ran with no speculation at all. Seen on real RLM runs
+    (2026-11-09): a turn's 787 sub-calls all missed."""
+    eng = MockLM(SLOW_STREAM)
+    out, kinds, bus = run_turn(eng, "spec", BATCHED_LOOP)
+    base, _, _ = run_turn(MockLM(SLOW_STREAM), "baseline", BATCHED_LOOP)
+    assert norm(out.final_answer) == norm(base.final_answer)
+    assert not [e.data for e in bus.history if e.kind == "note"]  # no failed peek either
+    assert kinds.count("shadow_exec") == 5  # the shadow ran every statement
+    assert kinds.count("dispatch") == 4 and kinds.count("claim_hit") == 4
+    assert kinds.count("claim_miss") == 0
