--- a/tests/test_rlm_adapter.py
+++ b/tests/test_rlm_adapter.py
@@ -103,3 +103,79 @@ def test_helper_defined_in_earlier_turn_still_speculates():
     assert len(calls) - n_after_define == 8, "block executed twice (shadow + real)"
     assert hits == 16, f"cross-turn helper did not speculate: {hits} hits"
     assert wall < 8 * 0.05, f"no fan-out on reused helper: {wall:.2f}s"
+
+
+# ---------------------------------------------------------------- scout and rlm_query
+LOOP_CODE = (
+    "chunks = [context[i:i+12] for i in range(0, 96, 12)]\n"
+    "def label_all(chunks):\n"
+    "    out = []\n"
+    "    for c in chunks:\n"
+    "        prompt = 'label: ' + c\n"
+    "        out.extend(llm_query(prompt).strip().split('\\n'))\n"  # uses each result
+    "    return out\n"
+    "labels = label_all(chunks)\n"
+    "answer['content'] = '|'.join(labels)\n"
+    "answer['ready'] = True"
+)
+
+
+def _drive(repl, code):
+    """A streamed turn, then the real run, as a streaming RLM client drives the REPL."""
+    response = "Working.\n```repl\n" + code + "\n```\nDone."
+    t0 = time.perf_counter()
+    repl.begin_stream_turn()
+    for i in range(0, len(response), 9):
+        repl.feed(response[i : i + 9])
+        time.sleep(0.002)
+    repl.end_stream_turn()
+    result = repl.execute_code(code)
+    return result, time.perf_counter() - t0
+
+
+def test_adapter_scout_turns_a_serial_loop_into_a_fan_out():
+    """Eight calls of 0.4 s in a helper loop that uses each result. As shipped the shadow
+    launches them one after another; with the scout they all go out at once."""
+    from demo.rlm import SpeculativeLocalREPL
+
+    ctx = "abcdefghijkl" * 8
+    # auto_speculate off: the stream feeds the shadow, as a streaming client does
+    kw = {"context_payload": ctx, "subcall_override": slow_mock_llm, "auto_speculate": False}
+    plain = SpeculativeLocalREPL(**kw)
+    r0, wall0 = _drive(plain, LOOP_CODE)
+    scout = SpeculativeLocalREPL(spec_scout=True, **kw)
+    r1, wall1 = _drive(scout, LOOP_CODE)
+    assert r1.final_answer == r0.final_answer and r1.final_answer.count("|") == 7
+    assert sum(e.kind == "claim_hit" for e in scout.bus.history) == 8
+    assert not any(e.kind in ("claim_miss", "evict") for e in scout.bus.history)
+    assert wall0 > 8 * 0.4 * 0.9  # one after another
+    assert wall1 < 4 * 0.4  # together
+
+
+RLM_QUERY_CODE = (
+    "parts = rlm_query_batched(['part ' + str(i) + ': ' + context[:10] for i in range(4)])\n"
+    "head = rlm_query('headline for: ' + context[:10])\n"
+    "answer['content'] = '|'.join(parts) + '||' + head\n"
+    "answer['ready'] = True"
+)
+
+
+def test_rlm_query_without_recursion_can_be_speculated():
+    from demo.rlm import SpeculativeLocalREPL
+
+    kw = {"context_payload": "hello world", "subcall_override": slow_mock_llm,
+          "auto_speculate": False}
+    # as shipped: never speculated, and the statements that use the result are skipped
+    plain = SpeculativeLocalREPL(**kw)
+    _drive(plain, RLM_QUERY_CODE)
+    assert not any(e.kind == "dispatch" for e in plain.bus.history)
+    assert any(e.kind in ("shadow_skip", "shadow_stop") for e in plain.bus.history)
+    # asked for: the five calls run early and are claimed
+    spec = SpeculativeLocalREPL(spec_rlm_query=True, **kw)
+    r1, wall = _drive(spec, RLM_QUERY_CODE)
+    assert r1.final_answer == (
+        "|".join(f"ans(part {i}: hello worl)" for i in range(4))
+        + "||ans(headline for: hello worl)")
+    assert sum(e.kind == "claim_hit" for e in spec.bus.history) == 5
+    assert not any(e.kind in ("claim_miss", "shadow_stop") for e in spec.bus.history)
+    assert wall < 5 * 0.4  # not one after another
diff --git a/tests/test_scout.py b/tests/test_scout.py
new file mode 100644
index 0000000..e0495c7
--- /dev/null
+++ b/tests/test_scout.py
@@ -0,0 +1,276 @@
+"""The scout pass: a loop's independent calls go out together.
+
+The shadow runs a statement as the program would, so it waits wherever a result is used.
+In real RLM code that is inside the loop that made the call: the calls then go out one
+after another, each after the one before has answered, although none needs another.
+(Measured on OOLONG runs, 2026-11-09: 73% of what the streaming mode still waited for.)
+
+The scout runs each closed statement once more, ahead of the shadow, with tool calls that
+return at once. It launches every call whose arguments are known and never waits. The
+programs below are the shapes the model wrote in those runs, shortened. All mock: no
+network, no model."""
+
+import re
+
+from spec_ptc.contracts.events import EventBus
+from spec_ptc.runtime.engines import MockLM, MockTiming
+from spec_ptc.runtime.harness import Harness
+
+TIMING = MockTiming(main_tok_per_s=2000, sub_base_s=0.25, sub_jitter_s=0.1, sub_tokens=3)
+CONTEXT = "\n".join(f"Q{i}: what is item number {i} ?" for i in range(24))
+
+
+def norm(s):
+    return re.sub(r"\[\w+#\d+\] ", "", s or "")
+
+
+def run_turn(code, mode="spec", scout=True, eng=None):
+    eng = eng or MockLM(TIMING)
+    bus = EventBus()
+    h = Harness(eng, mode, bus=bus, context=CONTEXT, scout=scout and mode == "spec")
+    out = h.run_turn(eng.stream_main(f"go\n```repl\n{code}\n```\ndone"))
+    h.launcher.shutdown()
+    return out, bus.history, h
+
+
+def kinds(history):
+    return [e.kind for e in history]
+
+
+def launched_before_first_answer(history) -> int:
+    """Calls dispatched before any speculative call had answered."""
+    n = 0
+    for e in history:
+        if e.kind == "ready":
+            break
+        n += e.kind == "dispatch"
+    return n
+
+
+def check_all_claimed(out, history, n, base):
+    k = kinds(history)
+    assert out.final_answer is not None and norm(out.final_answer) == norm(base.final_answer)
+    assert k.count("dispatch") == n and k.count("claim_hit") == n
+    assert k.count("claim_miss") == 0 and k.count("evict") == 0  # nothing missed or wasted
+
+
+# --------------------------------------------------------- the three recorded shapes
+HELPER_LOOP = (
+    "questions = context.split('\\n')\n"
+    "def create_prompt(batch):\n"
+    "    return 'Classify each of these: ' + ' | '.join(batch)\n"
+    "def classify_all(questions, batch_size=2):\n"
+    "    results = []\n"
+    "    for i in range(0, len(questions), batch_size):\n"
+    "        batch = questions[i:i + batch_size]\n"
+    "        prompt = create_prompt(batch)\n"
+    "        batch_results = llm_query(prompt).strip().split('\\n')\n"  # the result is used
+    "        results.extend(batch_results)\n"
+    "        print(f'Processed batch {i//batch_size + 1}')\n"
+    "    return results\n"
+    "all_c = classify_all(questions, batch_size=2)\n"
+    "answer['content'] = str(len(all_c))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_helper_loop_that_uses_each_result_launches_all_its_calls_at_once():
+    base, _, _ = run_turn(HELPER_LOOP, mode="baseline")
+    out, hist, _ = run_turn(HELPER_LOOP)
+    check_all_claimed(out, hist, 12, base)
+    assert launched_before_first_answer(hist) == 12
+    assert {e.data["source"] for e in hist if e.kind == "dispatch"} == {"peek"}
+    assert kinds(hist).count("adopt") == 12  # the shadow took each one over as it got there
+    # the same turn without the scout: the shadow stalls at every call
+    out2, hist2, _ = run_turn(HELPER_LOOP, scout=False)
+    assert norm(out2.final_answer) == norm(base.final_answer)
+    assert launched_before_first_answer(hist2) == 1
+    # twelve calls of at least 0.25 s: one after another they need 3 s
+    assert out.metrics.t_turn < 1.5 < out2.metrics.t_turn
+
+
+BATCHED_LOOP_WITH_COUNTER = (
+    "from collections import Counter\n"
+    "questions = context.split('\\n')\n"
+    "label_counts = Counter()\n"
+    "batch_size = 4\n"
+    "for i in range(0, len(questions), batch_size):\n"
+    "    batch = questions[i:i+batch_size]\n"
+    "    prompts = [f'Classify. Question: {q}' for q in batch]\n"
+    "    results = llm_query_batched(prompts)\n"
+    "    for r in results:\n"
+    "        label_counts[r] += 1\n"  # hashing r needs its value
+    "answer['content'] = str(sum(label_counts.values()))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_batches_in_a_loop_all_go_out_before_the_first_answer():
+    base, _, _ = run_turn(BATCHED_LOOP_WITH_COUNTER, mode="baseline")
+    out, hist, _ = run_turn(BATCHED_LOOP_WITH_COUNTER)
+    check_all_claimed(out, hist, 24, base)
+    assert out.final_answer == "24"
+    assert launched_before_first_answer(hist) == 24
+    _, hist2, _ = run_turn(BATCHED_LOOP_WITH_COUNTER, scout=False)
+    assert launched_before_first_answer(hist2) == 4  # one batch, then it waits
+
+
+TRY_LOOP = (
+    "questions = context.split('\\n')\n"
+    "labels = []\n"
+    "for i in range(0, len(questions), 3):\n"
+    "    batch = questions[i:i + 3]\n"
+    "    prompt = ('Classify each, one per line:\\n' + '\\n'.join(batch))\n"
+    "    try:\n"
+    "        response = llm_query(prompt)\n"
+    "        batch_labels = [ln.strip() for ln in response.strip().split('\\n') if ln.strip()]\n"
+    "        labels.extend(batch_labels)\n"
+    "        print(f'Processed batch {i//3 + 1}, first: {batch_labels[:1]}')\n"
+    "    except Exception as e:\n"
+    "        print(f'Error in batch: {e}')\n"
+    "        for q in batch:\n"
+    "            labels.append(llm_query(f'Classify: {q}').strip())\n"
+    "answer['content'] = str(len(labels))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_loop_with_try_launches_its_calls_and_not_its_fallback():
+    base, _, _ = run_turn(TRY_LOOP, mode="baseline")
+    out, hist, _ = run_turn(TRY_LOOP)
+    check_all_claimed(out, hist, 8, base)  # 8 batches; none of the 24 fallback calls
+    assert launched_before_first_answer(hist) == 8
+
+
+# --------------------------------------------------------- what the scout must not do
+CHAIN = (
+    "a = llm_query('first: ' + context[:20])\n"
+    "b = llm_query('second: ' + str(a))\n"  # needs a
+    "c = llm_query('third: ' + context[20:40])\n"  # needs nothing
+    "answer['content'] = str(a) + '|' + str(b) + '|' + str(c)\n"
+    "answer['ready'] = True"
+)
+
+
+def test_a_dependent_call_waits_and_the_call_after_it_does_not():
+    base, _, _ = run_turn(CHAIN, mode="baseline")
+    out, hist, _ = run_turn(CHAIN)
+    check_all_claimed(out, hist, 3, base)
+    at = {}
+    for i, e in enumerate(hist):
+        if e.kind == "dispatch":
+            at[e.data["preview"].strip("'").split(":")[0]] = i
+    first_ready = kinds(hist).index("ready")
+    assert at["first"] < first_ready and at["third"] < first_ready  # no stall behind b
+    assert at["second"] > first_ready  # b only once a had answered
+    # without the scout, c waits behind b, which waits for a
+    _, hist2, _ = run_turn(CHAIN, scout=False)
+    assert launched_before_first_answer(hist2) == 1
+
+
+SCAN_UNTIL_FOUND = (
+    "chunks = [context[i:i+30] for i in range(0, 120, 30)]\n"
+    "found = None\n"
+    "for c in chunks:\n"
+    "    r = llm_query('scan: ' + c)\n"
+    "    if 'no-answer-says-this' in str(r):\n"
+    "        found = c\n"
+    "        break\n"
+    "answer['content'] = str(found)\n"
+    "answer['ready'] = True"
+)
+
+
+def test_the_scout_does_not_guess_past_a_test_on_a_result():
+    """Whether the loop goes on depends on the first answer. Launching the later
+    iterations would be a bet, and the scout places none."""
+    base, _, _ = run_turn(SCAN_UNTIL_FOUND, mode="baseline")
+    out, hist, _ = run_turn(SCAN_UNTIL_FOUND)
+    check_all_claimed(out, hist, 4, base)
+    assert launched_before_first_answer(hist) == 1
+    assert [e.data["reason"] for e in hist if e.kind == "scout_skip"][0] == "needs a value"
+
+
+MUTATING = (
+    "seen = []\n"
+    "for q in context.split('\\n')[:4]:\n"
+    "    seen.append(llm_query('note: ' + q))\n"
+    "answer['content'] = str(len(seen))\n"
+    "answer['ready'] = True"
+)
+
+
+def test_the_scout_works_on_its_own_copy_of_the_variables():
+    out, hist, h = run_turn(MUTATING)
+    assert out.final_answer == "4" and len(h.repl.locals["seen"]) == 4
+    assert all(isinstance(x, str) for x in h.repl.locals["seen"])
+    assert kinds(hist).count("dispatch") == 4 and kinds(hist).count("evict") == 0
+
+
+SHADOW_STOPS = (
+    "lines = context.split('\\n')[:4]\n"
+    "a = [llm_query('Noun in: ' + lines[0]), llm_query('Noun in: ' + lines[1])]\n"
+    "import socket\n"  # not on the shadow's import list: the shadow stops here
+    "b = [llm_query('Verb in: ' + lines[2]), llm_query('Verb in: ' + lines[3])]\n"
+    "answer['content'] = str(len(a) + len(b)) + socket.__name__\n"
+    "answer['ready'] = True"
+)
+
+
+def test_calls_after_the_shadow_stops_are_still_launched():
+    base, _, _ = run_turn(SHADOW_STOPS, mode="baseline")
+    out, hist, _ = run_turn(SHADOW_STOPS)
+    assert "shadow_stop" in kinds(hist)  # the shadow did stop at the import
+    check_all_claimed(out, hist, 4, base)
+    # without the scout the two calls after the import are made by the real run itself
+    _, hist2, _ = run_turn(SHADOW_STOPS, scout=False)
+    assert kinds(hist2).count("claim_miss") == 2
+
+
+def test_the_scout_is_off_unless_asked_for():
+    out, hist, _ = run_turn(HELPER_LOOP, scout=False)
+    assert not [e for e in hist if e.kind.startswith("scout_")]
+    assert {e.data["source"] for e in hist if e.kind == "dispatch"} <= {"shadow", "peek"}
+
+
+RUNAWAY = (
+    "n = 0\n"
+    "while True:\n"  # never ends: the scout's watchdog and the shadow's must both cut it
+    "    n += 1\n"
+    "    if n > 10**12:\n"
+    "        break\n"
+)
+
+
+def test_a_statement_that_spins_is_cut_and_the_calls_after_it_still_go_out():
+    """The scout gives a statement the shadow's compute budget, then moves on."""
+    import threading
+
+    from spec_ptc.contracts.tools import ToolRegistry
+    from spec_ptc.engine.shadow import ShadowRunner
+    from spec_ptc.engine.speculation import Launcher, SpecStore, make_scout_hooks
+    from spec_ptc.engine.streaming import Segment
+    from spec_ptc.runtime.harness import REAL_BUILTINS
+
+    reg = ToolRegistry()
+    reg.register("llm_query", lambda p: f"ans({p})", speculatable=True, pure=True)
+    bus = EventBus()
+    store = SpecStore(bus)
+    launcher = Launcher(store, bus)
+    scout = ShadowRunner({}, make_scout_hooks(reg, launcher), store, REAL_BUILTINS, bus,
+                         launcher=launcher, registry=reg, scout=True)
+    segs = [Segment(0, 0, RUNAWAY), Segment(0, 1, "x = llm_query('after the loop')")]
+    for s in segs:
+        s.scouted = threading.Event()
+        scout.feed(s)
+    scout.finish()
+    assert scout.join(10) and all(s.scouted.is_set() for s in segs)
+    skips = [e.data["reason"] for e in bus.history if e.kind == "scout_skip"]
+    assert skips == ["ShadowAborted"]
+    assert [e.data["preview"] for e in bus.history if e.kind == "dispatch"] == ["'after the loop'"]
+    # a segment fed after the scout has ended is released at once
+    late = Segment(0, 2, "y = 1")
+    late.scouted = threading.Event()
+    scout.feed(late)
+    assert late.scouted.is_set()
+    launcher.shutdown()
