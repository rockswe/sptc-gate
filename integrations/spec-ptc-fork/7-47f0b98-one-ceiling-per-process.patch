+# ------------------------------------------------- several sessions, one process
+class Pair:
+    """Two governed sessions of one process on one engine (or on two, if asked)."""
+
+    def __init__(self, engines: int = 1, **cfg) -> None:
+        self.clock = Clock()
+        self.engs = [FakeEngine(clock=self.clock) for _ in range(engines)]
+        self.cfg = GovernorConfig(**cfg)
+        self.budgets = [Budget(max_inflight=self.cfg.w_init, max_window=self.cfg.w_max)
+                        for _ in range(2)]
+        self.buses = [EventBus(), EventBus()]
+        self.govs = [Governor(b, self.engs[i % engines].probe, None, self.buses[i], self.cfg,
+                              clock=self.clock, cpu_clock=lambda: 0.0, ticker=False)
+                     for i, b in enumerate(self.budgets)]
+        self.tick()
+
+    def burst(self, i: int, wanted: int = 787) -> None:
+        """Session i has a call in flight and a batch waiting for `wanted` places."""
+        b = self.budgets[i]
+        b._slots = 1
+        b._slot_queue.clear()
+        b._slot_queue.append([wanted, 0, threading.Event()])
+
+    def hold(self, i: int, calls: int) -> None:
+        """Session i has `calls` calls in flight and nothing waiting."""
+        self.budgets[i]._slots = calls
+        self.budgets[i]._slot_queue.clear()
+
+    def tick(self, n: int = 1, **engine) -> list[int]:
+        for _ in range(n):
+            for k, eng in enumerate(self.engs):
+                eng.sample(dt=0.25 if k == 0 else 0.0, **engine)
+            ws = [g.tick() for g in self.govs]
+        return ws
+
+    def why(self, i: int) -> list[str]:
+        return [h[2] for h in self.govs[i].history]
+
+
+def test_what_the_other_sessions_leave_of_the_ceiling():
+    assert share_for(256, []) == 256
+    assert share_for(256, [4]) == 252  # four long calls take four places
+    assert share_for(256, [787]) == 128  # two bursts: half each
+    assert share_for(256, [4, 787]) == 126  # the small one first, the rest in halves
+    assert share_for(256, [787, 787, 787]) == 64
+    assert share_for(256, [10, 200]) == 123
+    assert share_for(256, [100, 200]) == pytest.approx(85.33, abs=0.01)  # both above a third
+
+
+def test_a_budget_says_what_its_session_would_use():
+    b = Budget(max_inflight=2, max_window=8)
+    assert b.wanted() == 0
+    assert b.acquire_slots(1) == 1 and b.acquire_slots(1) == 1
+    waiter = threading.Thread(target=b.acquire_slots, args=(5, 5.0), daemon=True)
+    waiter.start()
+    deadline = time.time() + 2
+    while b.waiters() == 0 and time.time() < deadline:
+        time.sleep(0.005)
+    assert (b.in_use(), b.waiters(), b.wanted()) == (2, 1, 7)
+    b.release_slots(2)  # the waiter takes the window as it is: 2 of its 5
+    waiter.join(2)
+    assert (b.in_use(), b.wanted()) == (2, 2)
+
+
+def test_alone_a_session_has_the_whole_ceiling():
+    p = Pair()
+    p.burst(0)
+    assert [p.tick()[0] for _ in range(7)] == [24, 36, 54, 81, 121, 181, 256]
+    assert p.budgets[1].max_inflight == 16  # the other one asked for nothing
+
+
+def test_two_sessions_that_burst_at_once_have_half_the_ceiling_each():
+    p = Pair()
+    p.burst(0)
+    p.tick(7)
+    assert p.budgets[0].max_inflight == 256
+    p.burst(1)  # measured: both at 256, 515 calls in flight in one process
+    assert p.tick() == [128, 24]  # the first gives way at once, the second starts to grow
+    assert p.why(0)[-1] == "share"
+    assert p.tick(6) == [128, 128]
+    assert p.tick(4) == [128, 128]  # and neither goes on from there
+    ev = [e for e in p.buses[0].history if e.kind == "govern"][-1]
+    assert ev.data["why"] == "share" and ev.data["share"] == 128 and ev.data["was"] == 256
+
+
+def test_when_the_other_session_is_done_the_window_grows_again():
+    p = Pair()
+    p.burst(0)
+    p.burst(1)
+    assert p.tick(8) == [128, 128]
+    p.hold(1, 0)  # its burst is over
+    assert [p.tick()[0] for _ in range(2)] == [192, 256]
+    assert p.why(0)[-2:] == ["grow", "grow"]  # by half again: nothing had said stop
+
+
+def test_a_session_with_a_few_long_calls_takes_only_their_places():
+    p = Pair()
+    p.hold(1, 4)  # four calls on long prompts, in flight for minutes
+    p.burst(0)
+    assert p.tick(8)[0] == 252
+    assert p.budgets[1].max_inflight == 16
+
+
+def test_sessions_on_different_engines_do_not_share():
+    p = Pair(engines=2)
+    p.burst(0)
+    p.burst(1)
+    assert p.tick(8) == [256, 256]
+
+
+def test_a_closed_session_asks_for_nothing():
+    p = Pair()
+    p.burst(0)
+    p.burst(1)
+    assert p.tick(8) == [128, 128]
+    p.govs[1].close()  # its budget still looks busy
+    assert p.tick(2)[0] == 256
+
+
+def test_the_share_is_never_under_where_a_window_starts():
+    p = Pair(w_max=24)  # two bursts would have 12 each
+    p.burst(0)
+    p.burst(1)
+    assert p.tick(4) == [16, 16]
+    assert p.why(0) == [] and p.why(1) == []
+
+
+def test_without_a_ceiling_for_the_process_each_session_has_its_own():
+    p = Pair(w_process=0)
+    p.burst(0)
+    p.burst(1)
+    assert p.tick(8) == [256, 256]
+    q = Pair(w_process=64)
+    q.burst(0)
+    q.burst(1)
+    assert q.tick(8) == [32, 32]
+
+
+def test_a_cut_by_the_engine_keeps_its_reason_when_the_share_is_lower_still():
+    p = Pair()
+    p.burst(0)
+    p.tick(7)
+    p.burst(1)
+    # a standing queue for three samples: the first window is cut for it, and its share
+    # (128) is under 0.7 of 256 as well
+    p.budgets[1]._slot_queue.clear()
+    p.budgets[1]._slots = 0
+    p.tick(2, waiting=200, running=256)
+    p.burst(1)
+    ws = p.tick(1, waiting=200, running=256)
+    assert ws[0] == 128 and p.why(0)[-1] == "queue"
+
+
