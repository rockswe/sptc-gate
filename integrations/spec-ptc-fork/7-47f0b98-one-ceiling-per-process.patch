+def share_for(total: float, others: list[int]) -> float:
+    """What is left of `total` places for one session that would take any number, next to
+    sessions that ask for `others`: each of those gets what it asks for if that is no more
+    than an equal share of what is left, and the rest share equally (max-min)."""
+    left, n = float(total), len(others) + 1
+    for want in sorted(others):
+        if want > left / n:
+            break
+        left -= want
+        n -= 1
+    return left / n
+
