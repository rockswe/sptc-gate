+def two_governed_turns(n: int = 240, **cfg):
+    """Two sessions of one process run the same loop at the same time on one engine."""
+    eng = Counting()
+    config = GovernorConfig(tick_s=0.05, **cfg)
+    probe = EngineProbe(fetch=lambda: metrics(), every=0.05).start()
+    context = "\n".join(f"Q{i}: what is item number {i} ?" for i in range(n))
+    outs, moves = [None, None], [[], []]
+
+    def one(i: int) -> None:
+        bus = EventBus()
+        budget = Budget(max_inflight=config.w_init, max_window=config.w_max,
+                        max_dispatches_per_turn=4096)
+        gov = Governor(budget, probe, None, bus, config)
+        h = Harness(eng, "spec", bus=bus, context=context, scout=True, budget=budget)
+        try:
+            outs[i] = h.run_turn(eng.stream_main(f"go\n```repl\n{LOOP}\n```\ndone"))
+        finally:
+            gov.close()
+            h.launcher.shutdown()
+            moves[i] = [e.data for e in bus.history if e.kind == "govern"]
+
+    threads = [threading.Thread(target=one, args=(i,)) for i in range(2)]
+    for th in threads:
+        th.start()
+    for th in threads:
+        th.join(60)
+    probe.stop()
+    return outs, moves, eng
+
+
+def test_two_sessions_at_once_stay_under_one_ceiling_together():
+    outs, moves, eng = two_governed_turns(w_init=4, w_max=64)
+    assert [o.final_answer for o in outs] == ["240", "240"]
+    # 32 each once both ask; a little more for the moment in which the second one starts
+    assert 32 < eng.peak <= 80
+    assert all(m["window"] <= 64 for ms in moves for m in ms)
+    assert any(m["share"] == 32 for ms in moves for m in ms)
+
+
+def test_without_the_process_ceiling_two_sessions_have_twice_the_calls_in_flight():
+    outs, _moves, eng = two_governed_turns(w_init=4, w_max=64, w_process=0)
+    assert [o.final_answer for o in outs] == ["240", "240"]
+    assert eng.peak > 100  # 64 each
+
