+# --------------------------------------------------------------------------- TensorRT-LLM
+# what trtllm-serve 1.4.0rc3 writes at /prometheus/metrics (shortened; the names and the
+# dp_rank label are those of tensorrt_llm/metrics/collector.py)
+TRTLLM_TEXT = """\
+# HELP trtllm_num_requests_running Number of active requests
+# TYPE trtllm_num_requests_running gauge
+trtllm_num_requests_running{model_name="m"} 40.0
+trtllm_num_requests_waiting{model_name="m"} 3.0
+trtllm_num_scheduled_requests{dp_rank="0",model_name="m"} 37.0
+trtllm_num_generation_requests{dp_rank="0",model_name="m"} 30.0
+trtllm_num_context_requests{dp_rank="0",model_name="m"} 7.0
+trtllm_num_paused_requests{dp_rank="0",model_name="m"} 0.0
+trtllm_iteration_latency_seconds{model_name="m"} 0.045
+trtllm_kv_cache_utilization{dp_rank="0",model_name="m"} 0.375
+trtllm_kv_cache_max_blocks{dp_rank="0",model_name="m"} 4800.0
+trtllm_kv_cache_used_blocks{dp_rank="0",model_name="m"} 1800.0
+trtllm_kv_cache_tokens_per_block{dp_rank="0",model_name="m"} 32.0
+trtllm_generation_tokens_total{model_name="m"} 5000.0
+trtllm_time_per_output_token_seconds_sum{model_name="m"} 45.0
+trtllm_time_per_output_token_seconds_count{model_name="m"} 1000.0
+python_gc_objects_collected_total{generation="0"} 1234.0
+"""
+
+# all that trtllm-serve 1.2.1 writes there: times of finished requests, no gauge
+TRTLLM_121_TEXT = """\
+trtllm_request_success_total{finished_reason="stop",model_name="m"} 12.0
+trtllm_time_to_first_token_seconds_sum{model_name="m"} 3.5
+trtllm_time_to_first_token_seconds_count{model_name="m"} 12.0
+trtllm_time_per_output_token_seconds_sum{model_name="m"} 0.4
+trtllm_time_per_output_token_seconds_count{model_name="m"} 12.0
+trtllm_request_queue_time_seconds_sum{model_name="m"} 0.1
+trtllm_request_queue_time_seconds_count{model_name="m"} 12.0
+"""
+
+
+def trtllm(active=0, queued=0, scheduled=None, kv=0.0, paused=0, step_ms=25.0,
+           blocks=4800, steps=0) -> str:
+    """`active` requests in the engine's set, `scheduled` of them in its last step (all,
+    unless given). `steps` stands for whatever a step changes: a real engine's step
+    times differ from one step to the next, a test's do not."""
+    scheduled = active if scheduled is None else scheduled
+    cache = (f'trtllm_kv_cache_max_blocks{{dp_rank="0",model_name="m"}} {blocks}\n'
+             f'trtllm_kv_cache_used_blocks{{dp_rank="0",model_name="m"}} {kv * blocks}\n'
+             f'trtllm_kv_cache_tokens_per_block{{dp_rank="0",model_name="m"}} 32\n'
+             if blocks else "")
+    return (f'trtllm_num_requests_running{{model_name="m"}} {active}\n'
+            f'trtllm_num_requests_waiting{{model_name="m"}} {queued}\n'
+            f'trtllm_num_scheduled_requests{{dp_rank="0",model_name="m"}} {scheduled}\n'
+            f'trtllm_num_paused_requests{{dp_rank="0",model_name="m"}} {paused}\n'
+            f'trtllm_iteration_latency_seconds{{model_name="m"}} {step_ms / 1000.0}\n'
+            f'trtllm_num_requests_completed_total{{model_name="m"}} {steps}\n'
+            + cache)
+
+
+class TrtEngine:
+    """A TensorRT-LLM server's metrics text that a test sets. Each sample is of a new
+    step, unless step=False: then the engine has not stepped and writes what it wrote."""
+
+    def __init__(self, clock=None, **kw) -> None:
+        self.kw = dict(kw)
+        self.steps = 0
+        self.body = None  # set to answer with something else than the text
+        self.clock = clock or Clock()
+        self.probe = EngineProbe(fetch=self.read, clock=self.clock)
+
+    def read(self) -> str:
+        return self.body if self.body is not None else trtllm(steps=self.steps, **self.kw)
+
+    def sample(self, dt: float = 0.25, step: bool = True, **kw) -> EngineLoad:
+        if step:
+            self.kw.update(kw)
+            self.steps += 1
+        self.clock.t += dt
+        return self.probe.poll()
+
+
+def test_the_probe_reads_what_tensorrt_llm_exports():
+    m = parse_metrics(TRTLLM_TEXT)
+    assert m["running"] == 37 and m["kv"] == 0.375 and m["kv_tokens"] == 4800 * 32
+    assert m["waiting"] == 3 + (40 - 37)  # in its queue, and in its set but not in the step
+    assert m["paused"] == 0 and m["step_ms"] == pytest.approx(45.0)
+    # a mean over a finished request's life is not the time between two tokens now, and
+    # tokens are counted when a request ends, not as they are written
+    assert not m.keys() & {"itl_sum", "itl_count", "gen_tokens", "preemptions"}
+
