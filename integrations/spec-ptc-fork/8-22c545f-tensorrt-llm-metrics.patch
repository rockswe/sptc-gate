+# TensorRT-LLM (trtllm-serve, /prometheus/metrics): its names carry this prefix.
+TRTLLM_PREFIX = "trtllm_"
+# What only changes when the engine has run a step. Its gauges are written from one
+# record per step and keep their last value while it does not step, so two samples that
+# agree in all of these are one step seen twice.
+_TRTLLM_STEP = (
+    "iteration_latency_seconds", "kv_cache_used_blocks", "num_scheduled_requests",
+    "num_generation_requests", "num_context_requests", "total_context_tokens",
+    "num_requests_running", "num_requests_waiting", "num_requests_completed_total",
+    "generation_tokens_total",
+)
+
+
+def _trtllm_metrics(v: dict[str, list[float]]) -> dict:
+    """What the governor reads, from a TensorRT-LLM server's metrics (`v`: every label
+    set's value of a metric, by its name without the prefix). Read from the sources of
+    1.4.0rc3. 1.2.1 writes none of the gauges below, only times of finished requests:
+    its text is refused, as a JSON body is (parse_metrics).
+
+    The same five signals as from vLLM, where the engine means the same by them:
+
+    - waiting. num_requests_waiting counts the requests that are not in the engine's
+      active set yet, and that set is as large as its batch. A request the scheduler
+      holds back for KV cache is in the set and not in a step: it is one of
+      num_requests_running and not one of num_scheduled_requests. Both are "requests the
+      engine could not schedule in its last step", so both are counted, and running is
+      what was scheduled. The default scheduler (GUARANTEED_NO_EVICT) never preempts,
+      so a full KV cache shows here and nowhere else.
+    - kv: blocks used over blocks there are, summed over the ranks.
+    - paused: requests the scheduler paused in the last step (MAX_UTILIZATION only). It
+      is a gauge of one step, not a running total: the probe adds them up.
+    - step_ms: how long the last step took. Every stream gets a token a step, so it is
+      the time between two tokens now. time_per_output_token_seconds is a mean over a
+      request's whole life, written when the request ends, and is not read.
+    - step_sig: see _TRTLLM_STEP. An engine with nothing to do runs no step and keeps
+      the numbers of its last one, so it reads as an engine that is not stepping until
+      its next step: a burst's first sample or two do not widen the window."""
+
+    def total(name: str) -> float | None:
+        return sum(v[name]) if name in v else None
+
+    def mean(name: str) -> float | None:
+        return sum(v[name]) / len(v[name]) if name in v else None
+
+    out: dict = {}
+    active, queued = total("num_requests_running"), total("num_requests_waiting")
+    scheduled = total("num_scheduled_requests")
+    held = None  # in the active set and not in the last step
+    if active is not None and scheduled is not None:
+        held = max(0.0, active - scheduled)
+    running = scheduled if held is not None else active
+    if running is not None:
+        out["running"] = running
+    if queued is not None or held is not None:
+        out["waiting"] = (queued or 0.0) + (held or 0.0)
+    used, blocks = total("kv_cache_used_blocks"), total("kv_cache_max_blocks")
+    if used is not None and blocks:
+        out["kv"] = used / blocks
+    elif "kv_cache_utilization" in v:
+        out["kv"] = mean("kv_cache_utilization")
+    per_block = mean("kv_cache_tokens_per_block")
+    if blocks and per_block:
+        out["kv_tokens"] = int(blocks * per_block)
+    if "num_paused_requests" in v:
+        out["paused"] = total("num_paused_requests")
+    if "iteration_latency_seconds" in v:
+        out["step_ms"] = 1000.0 * mean("iteration_latency_seconds")
+    if not out.keys() & {"running", "waiting", "kv"}:
+        raise ValueError(
+            "this TensorRT-LLM server exports no gauges of its engine (1.2.1 does not; "
+            "1.4.0rc3 does, with enable_iter_perf_stats)")
+    sig = tuple((name, tuple(v[name])) for name in _TRTLLM_STEP if name in v)
+    if sig:
+        out["step_sig"] = sig
+    return out
+
