+    assert r.tick(4, active=4) == 81 and r.why == ["grow"] * 4
+    assert r.tick(8, active=40) == 256
+
+
+def test_requests_held_inside_tensorrt_llm_stop_growth_and_a_standing_number_cuts():
+    r = Rig(engine=TrtEngine)
+    r.tick(3, active=12)  # 54
+    assert r.tick(active=13, scheduled=12) == 54  # one held: its places are full
+    assert r.tick(2, active=20, scheduled=12) == 54  # 8 held, of 12 in the step
+    assert r.tick(active=20, scheduled=12) == 37 and r.why[-1] == "queue"
+    assert r.tick(active=12) == 41  # by an eighth: the cut is one sample old
+
+
+def test_tensorrt_llms_queue_counts_with_what_it_holds_inside():
+    r = Rig(engine=TrtEngine)
+    r.tick(3, active=12)  # 54
+    assert r.tick(2, active=12, queued=3) == 54  # 3 in its queue, 12 in the step
+    assert r.tick(active=12, queued=3) == 37 and r.why[-1] == "queue"
+
+
+def test_a_request_tensorrt_llm_paused_halves_the_window_once():
+    r = Rig(engine=TrtEngine)
+    r.tick(4, active=4)  # 81
+    assert r.tick(active=4, paused=1) == 40 and r.why[-1] == "preempted"
+    assert r.tick(3, step=False) == 40  # the same step seen again: no second cut
+    assert r.tick(active=4, paused=1) == 20  # it paused again in a new step
+    assert r.tick(active=4, paused=0) == 22
+
+
+def test_an_idle_tensorrt_llm_keeps_its_last_numbers_and_the_window_waits_for_a_step():
+    """It runs no step with nothing to do, so its gauges stay at the last step's: one or
+    more requests "running". That reads as an engine that is not stepping."""
+    r = Rig(engine=TrtEngine)
+    assert r.tick(2, active=4) == 36
+    assert r.tick(8, step=False) == 36  # the burst's calls are sent, no step seen yet
+    assert r.tick(active=16) == 54
