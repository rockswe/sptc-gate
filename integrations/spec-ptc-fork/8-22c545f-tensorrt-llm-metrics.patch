+def test_a_request_tensorrt_llm_holds_back_inside_its_set_is_waiting():
+    """The default scheduler never preempts: with the KV cache spoken for it leaves a
+    request in the active set and out of the step. Its queue is empty all the while."""
+    m = parse_metrics(trtllm(active=20, scheduled=12, queued=0))
+    assert m["running"] == 12 and m["waiting"] == 8
+    m = parse_metrics(trtllm(active=20, queued=0))
+    assert m["running"] == 20 and m["waiting"] == 0
+    # without the count of what was scheduled, its own two numbers are all there is
+    m = parse_metrics('trtllm_num_requests_running 20\ntrtllm_num_requests_waiting 5\n')
+    assert m["running"] == 20 and m["waiting"] == 5
+
