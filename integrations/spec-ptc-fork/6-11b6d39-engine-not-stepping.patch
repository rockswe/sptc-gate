+def test_an_engine_that_is_not_stepping_stops_growth():
+    """Measured on a T4 on November 11: a cold engine spent two seconds in one step. Its
+    numbers did not change (4 running, none waiting), eight samples in a row said so, and
+    the window went from 16 to 256 on them. Then 240 requests were waiting."""
+    r = Rig()
+    assert r.tick(running=4, tokens=1040) == 24  # it writes tokens: it steps
+    assert r.tick(8, running=4, tokens=1040) == 24  # in one long step: no growth
+    assert r.tick(running=4, tokens=1041) == 36
+    assert r.why == ["grow", "grow"]
+    # an engine with nothing in its batch is idle, not stalled
+    r2 = Rig()
+    r2.tick(running=0, tokens=500)
+    assert r2.tick(running=0, tokens=500) == 36
+
+
 def test_a_request_or_two_waiting_is_an_engine_with_its_places_full_not_a_queue():
     """Cutting until nothing waits would leave places of the engine empty. A standing
     queue is a quarter of what the engine runs, waiting."""
